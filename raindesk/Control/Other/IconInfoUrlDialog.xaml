<UserControl x:Class="raindesk.Control.Other.IconInfoUrlDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             MaxWidth="560"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Top">

    <Border Style="{StaticResource BorderBG}" CornerRadius="14" Padding="28">
        <Grid RowSpacing="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="72"
                        Height="72"
                        CornerRadius="22"
                        Background="{ThemeResource CardHoverBrush}"
                        BorderBrush="{ThemeResource CardBorderBrush}"
                        BorderThickness="1">
                    <Image x:Name="IconImg"
                           Width="42"
                           Height="42"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="4">
                    <TextBlock Text="URL 快捷方式"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource AppForegroundBrush}"/>
                    <TextBlock Text="保存一个网页、接口或远程资源入口"
                               FontSize="13"
                               Foreground="{ThemeResource SecondaryTextBrush}"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1" Spacing="18">
                <StackPanel Spacing="8">
                    <TextBlock Text="名称" FontSize="14" Foreground="{ThemeResource AppForegroundBrush}"/>
                    <TextBox x:Name="IconName"
                             Style="{StaticResource MyTextBoxStyle}"
                             Text="{Binding Name, Mode=OneWay}"
                             Height="44"
                             PlaceholderText="URL 名称"
                             AutomationProperties.Name="URL 名称"/>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="URL" FontSize="14" Foreground="{ThemeResource AppForegroundBrush}"/>
                    <TextBox x:Name="IconUrl"
                             Style="{StaticResource MyTextBoxStyle}"
                             Text="{Binding Path, Mode=OneWay}"
                             Height="44"
                             PlaceholderText="https://"
                             AutomationProperties.Name="URL 地址"/>
                </StackPanel>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="图标" FontSize="14" Foreground="{ThemeResource AppForegroundBrush}"/>
                        <TextBlock Text="为 URL 快捷方式选择展示图标"
                                   FontSize="13"
                                   Foreground="{ThemeResource SecondaryTextBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Style="{StaticResource raindeskCommandButtonStyle}"
                            Click="EditImage"
                            MinHeight="44"
                            AutomationProperties.Name="修改图标">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE790;" FontSize="14"/>
                            <TextBlock Text="修改"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2"
                            Style="{StaticResource raindeskCommandButtonStyle}"
                            Click="ReStoreImage"
                            MinHeight="44"
                            AutomationProperties.Name="重置图标">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE777;" FontSize="14"/>
                            <TextBlock Text="重置"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="12">
                <Button Content="取消"
                        Style="{StaticResource raindeskCommandButtonStyle}"
                        MinWidth="96"
                        MinHeight="44"
                        Click="Cancel_Click"
                        AutomationProperties.Name="取消"/>
                <Button Content="保存"
                        Style="{StaticResource raindeskPrimaryButtonStyle}"
                        MinWidth="112"
                        MinHeight="44"
                        Click="SaveProperty"
                        AutomationProperties.Name="保存"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
