<UserControl x:Class="raindesk.Control.UserControls.Config.ThemeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Background="Transparent"
             d:DesignHeight="720"
             d:DesignWidth="820">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14">
            <TextBlock Text="修改后立即生效并自动保存。"
                       Foreground="{ThemeResource SecondaryTextBrush}"
                       FontSize="12"
                       Margin="0,0,0,2"/>

            <TextBlock Text="应用主题"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource SecondaryTextBrush}"/>
            <Border Style="{StaticResource raindeskPanelStyle}">
                <Grid MinHeight="64" Padding="18,0" ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="应用主题" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="跟随系统或手动固定浅色、深色外观"
                                   Foreground="{ThemeResource SecondaryTextBrush}"
                                   FontSize="13"/>
                    </StackPanel>
                    <RadioButton x:Name="SystemThemeRadio"
                                 Grid.Column="1"
                                 Content="跟随系统"
                                 Style="{StaticResource MyRadioBtnStyle}"
                                 Checked="ThemeMode_Changed"
                                 MinHeight="44"
                                 AutomationProperties.Name="跟随系统主题"/>
                    <RadioButton x:Name="LightThemeRadio"
                                 Grid.Column="2"
                                 Content="浅色"
                                 Style="{StaticResource MyRadioBtnStyle}"
                                 Checked="ThemeMode_Changed"
                                 MinHeight="44"
                                 AutomationProperties.Name="浅色主题"/>
                    <RadioButton x:Name="DarkThemeRadio"
                                 Grid.Column="3"
                                 Content="深色"
                                 Style="{StaticResource MyRadioBtnStyle}"
                                 Checked="ThemeMode_Changed"
                                 MinHeight="44"
                                 AutomationProperties.Name="深色主题"/>
                </Grid>
            </Border>

            <TextBlock Text="背景设置"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource SecondaryTextBrush}"/>
            <Border Style="{StaticResource raindeskPanelStyle}">
                <StackPanel>
                    <Grid MinHeight="60" Padding="18,0" ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="背景类型" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold"/>
                        <RadioButton Grid.Column="1"
                                     Content="图片背景"
                                     Style="{StaticResource MyRadioBtnStyle}"
                                     Click="BGStyle_Changed"
                                     IsChecked="{Binding BGStyle, Mode=TwoWay, Converter={StaticResource BGStyleConvert}, ConverterParameter=1}"
                                     MinHeight="44"
                                     AutomationProperties.Name="图片背景"/>
                        <RadioButton Grid.Column="2"
                                     Content="渐变背景"
                                     Style="{StaticResource MyRadioBtnStyle}"
                                     Click="BGStyle_Changed"
                                     IsChecked="{Binding BGStyle, Mode=TwoWay, Converter={StaticResource BGStyleConvert}, ConverterParameter=2}"
                                     MinHeight="44"
                                     AutomationProperties.Name="渐变背景"/>
                    </Grid>
                    <Border Style="{StaticResource DividerLine}" Margin="0"/>

                    <Grid x:Name="ImgBGConf" MinHeight="112" Padding="18,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto" MinWidth="150"/>
                            <ColumnDefinition Width="Auto" MinWidth="140"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="背景图片" VerticalAlignment="Center" FontSize="16"/>
                        <Border Grid.Column="1"
                                Width="180"
                                MinWidth="150"
                                Height="82"
                                CornerRadius="8"
                                Background="{ThemeResource AccentLightBrush}"
                                BorderBrush="{ThemeResource CardBorderBrush}"
                                BorderThickness="1"
                                HorizontalAlignment="Left">
                            <Image Source="{Binding BitmapImage}"
                                   Stretch="UniformToFill"/>
                        </Border>
                        <StackPanel Grid.Column="2" Spacing="10" VerticalAlignment="Center">
                            <Button Content="更换图片"
                                    Style="{StaticResource raindeskPrimaryButtonStyle}"
                                    Click="BGButton_Click"
                                    AutomationProperties.Name="更换背景图片"/>
                            <Button Content="恢复默认"
                                    Style="{StaticResource raindeskCommandButtonStyle}"
                                    Click="DefaultButton_Click"
                                    AutomationProperties.Name="恢复默认背景"/>
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="GradientBGConf" MinHeight="112" Padding="18,12">
                        <StackPanel Spacing="10">
                            <TextBlock Text="纯色背景" FontSize="16" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <Button Content="系统预设" Style="{StaticResource raindeskCommandButtonStyle}" Click="SysBG_Click"
                                    AutomationProperties.Name="系统预设背景"/>
                                <Button Content="保存当前颜色到系统预设" Style="{StaticResource raindeskCommandButtonStyle}" Click="NewBGBtn_Click"
                                    AutomationProperties.Name="保存当前颜色"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource DividerLine}" Margin="0"/>

                    <Grid MinHeight="62" Padding="18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto" MinWidth="260"/>
                            <ColumnDefinition Width="Auto" MinWidth="48"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="背景透明度" VerticalAlignment="Center" FontSize="16"/>
                        <Slider Grid.Column="1"
                                Value="{Binding BgOpacity}"
                                ValueChanged="BGOpacity_ValueChanged"
                                Maximum="100"
                                TickFrequency="1"
                                StepFrequency="1"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding BgOpacity}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   Foreground="{ThemeResource SecondaryTextBrush}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="界面效果"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource SecondaryTextBrush}"/>
            <Border Style="{StaticResource raindeskPanelStyle}">
                <StackPanel>
                    <Grid MinHeight="64" Padding="18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="毛玻璃效果" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="对界面背景应用毛玻璃模糊效果" Foreground="{ThemeResource SecondaryTextBrush}" FontSize="13"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                      IsOn="{Binding BlurEffect, Mode=TwoWay}"
                                      Toggled="BlurEffect_Toggled"
                                      OffContent=""
                                      OnContent=""/>
                    </Grid>
                    <Border Height="1"
                            Margin="18,0"
                            Background="{ThemeResource DividerBrush}"/>
                    <Grid MinHeight="64" Padding="18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="隐藏搜索框" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="隐藏主界面顶部的搜索框" Foreground="{ThemeResource SecondaryTextBrush}" FontSize="13"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                      IsOn="{Binding HideSearchBox, Mode=TwoWay}"
                                      Toggled="HideSearchBox_Toggled"
                                      OffContent=""
                                      OnContent=""/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
