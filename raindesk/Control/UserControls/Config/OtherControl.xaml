<UserControl x:Class="raindesk.Control.UserControls.Config.OtherControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Background="Transparent"
             d:DesignHeight="560"
             d:DesignWidth="820">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14">
            <Border Style="{StaticResource raindeskPanelStyle}" Padding="20">
                <StackPanel>
                    <TextBlock Text="程序设置" Style="{StaticResource SectionHeaderStyle}" FontSize="17"/>
                    <Grid Margin="0,12,0,0" MinHeight="72">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE7E8;" FontFamily="Segoe Fluent Icons" FontSize="30"
                                  Foreground="{ThemeResource raindeskBlueBrush}"
                                  VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="开机自启动" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="系统启动时自动运行 raindesk"
                                       Foreground="{ThemeResource SecondaryTextBrush}"
                                       FontSize="13"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2"
                                      IsOn="{Binding SelfStartUp, Mode=TwoWay}"
                                      Toggled="SelfStartUpBox_Click"
                                      OffContent=""
                                      OnContent=""
                                      AutomationProperties.Name="开机自启动"/>
                    </Grid>
                    <Border Style="{StaticResource DividerLine}"/>
                    <Grid MinHeight="72">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE950;" FontFamily="Segoe Fluent Icons" FontSize="30"
                                  Foreground="{ThemeResource raindeskBlueBrush}"
                                  VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="性能模式" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="减少动画效果，提升运行性能"
                                       Foreground="{ThemeResource SecondaryTextBrush}"
                                       FontSize="13"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2"
                                      IsOn="{Binding PMModel, Mode=TwoWay}"
                                      OffContent=""
                                      OnContent=""
                                      AutomationProperties.Name="性能模式"/>
                    </Grid>
                    <Border Style="{StaticResource DividerLine}"/>
                    <Grid MinHeight="72">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE7F4;" FontFamily="Segoe Fluent Icons" FontSize="30"
                                  Foreground="{ThemeResource raindeskBlueBrush}"
                                  VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="显示托盘图标" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="关闭后仅保留任务栏/热键呼出，关闭窗口将直接退出"
                                       Foreground="{ThemeResource SecondaryTextBrush}"
                                       FontSize="13"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2"
                                      IsOn="{Binding ShowBarIcon, Mode=TwoWay}"
                                      Toggled="ShowBarIcon_Changed"
                                      OffContent=""
                                      OnContent=""
                                      AutomationProperties.Name="显示托盘图标"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource raindeskPanelStyle}" Padding="20">
                <StackPanel Spacing="14">
                    <Grid MinHeight="56">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="更新源"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="CheckUpdateButton"
                                Grid.Column="1"
                                Content="检查更新"
                                Click="CheckUpdate_Click"
                                Style="{StaticResource raindeskCommandButtonStyle}"
                                AutomationProperties.Name="检查更新"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="18">
                        <RadioButton Content="Gitee"
                                     GroupName="UpdateType"
                                     Style="{StaticResource MyRadioBtnStyle}"
                                     IsChecked="{Binding UpdateType, Mode=TwoWay, Converter={StaticResource UpdateTypeConvert}, ConverterParameter=1}"
                                     AutomationProperties.Name="Gitee 更新源"/>
                        <RadioButton Content="GitHub"
                                     GroupName="UpdateType"
                                     Style="{StaticResource MyRadioBtnStyle}"
                                     IsChecked="{Binding UpdateType, Mode=TwoWay, Converter={StaticResource UpdateTypeConvert}, ConverterParameter=2}"
                                     AutomationProperties.Name="GitHub 更新源"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource raindeskPanelStyle}" Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="排序方式" Style="{StaticResource SectionHeaderStyle}" FontSize="17"/>
                    <StackPanel Orientation="Horizontal" Spacing="18">
                        <RadioButton x:Name="CustomSort"
                                     Content="自定义"
                                     Tag="1"
                                     PointerPressed="SortType_PointerPressed"
                                     Style="{StaticResource MyRadioBtnStyle}"
                                     IsChecked="{Binding IconSortType, Mode=OneWay, Converter={StaticResource SortTypeConvert}, ConverterParameter=1}"/>
                        <RadioButton x:Name="CountUpSort"
                                     Content="使用次数"
                                     Tag="2"
                                     PointerPressed="SortType_PointerPressed"
                                     Style="{StaticResource MyRadioBtnStyle}"
                                     IsChecked="{Binding IconSortType, Mode=OneWay, Converter={StaticResource SortTypeConvert}, ConverterParameter=2}"/>
                        <RadioButton x:Name="CountLowSort"
                                     Content="使用次数"
                                     Tag="3"
                                     Visibility="Collapsed"
                                     PointerPressed="SortType_PointerPressed"
                                     Style="{StaticResource MyRadioBtnStyle}"
                                     IsChecked="{Binding IconSortType, Mode=OneWay, Converter={StaticResource SortTypeConvert}, ConverterParameter=3}"/>
                        <RadioButton x:Name="NameUpSort"
                                     Content="名称"
                                     Tag="4"
                                     PointerPressed="SortType_PointerPressed"
                                     Style="{StaticResource MyRadioBtnStyle}"
                                     IsChecked="{Binding IconSortType, Mode=OneWay, Converter={StaticResource SortTypeConvert}, ConverterParameter=4}"/>
                        <RadioButton x:Name="NameLowSort"
                                     Content="名称"
                                     Tag="5"
                                     Visibility="Collapsed"
                                     PointerPressed="SortType_PointerPressed"
                                     Style="{StaticResource MyRadioBtnStyle}"
                                     IsChecked="{Binding IconSortType, Mode=OneWay, Converter={StaticResource SortTypeConvert}, ConverterParameter=5}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource raindeskPanelStyle}" Padding="20">
                <Grid MinHeight="72">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="58"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE753;" FontFamily="Segoe Fluent Icons" FontSize="30"
                              Foreground="{ThemeResource raindeskBlueBrush}"
                              VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="备份数据" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="备份应用数据与配置到本地"
                                   Foreground="{ThemeResource SecondaryTextBrush}"
                                   FontSize="13"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                        <Button Content="立即备份"
                                Style="{StaticResource raindeskCommandButtonStyle}"
                                Click="BakDataFile"
                                AutomationProperties.Name="立即备份"/>
                        <Button Content="导入备份"
                                Style="{StaticResource raindeskCommandButtonStyle}"
                                AutomationProperties.Name="导入备份"
                                Click="ImportBackupFile"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
