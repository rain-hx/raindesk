<UserControl
    x:Class="raindesk.Control.UserControls.ToDo.TaskItemControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    PointerEntered="OnPointerEntered"
    PointerExited="OnPointerExited"
    Tapped="OnTapped">

    <UserControl.Resources>
        <Style x:Key="TaskCompleteCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Border x:Name="CheckBackground"
                                    Width="22"
                                    Height="22"
                                    CornerRadius="4"
                                    Background="{ThemeResource ControlFillBrush}"
                                    BorderBrush="{ThemeResource ControlBorderBrush}"
                                    BorderThickness="1.5"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform/>
                                </Border.RenderTransform>
                            </Border>
                            <FontIcon x:Name="CheckGlyph"
                                      Glyph="&#xE73E;"
                                      FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                      FontSize="12"
                                      Foreground="White"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Visibility="Collapsed"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Checked">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CheckBackground" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource raindeskBlueBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CheckBackground" Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource raindeskBlueBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CheckGlyph" Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CheckBackground"
                                                                           Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
                                                <DoubleAnimationUsingKeyFrames.KeyFrames>
                                                    <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1.0"/>
                                                    <SplineDoubleKeyFrame KeyTime="0:0:0.08" Value="1.15">
                                                        <SplineDoubleKeyFrame.KeySpline>
                                                            <KeySpline ControlPoint1="0.2,1" ControlPoint2="0.4,1"/>
                                                        </SplineDoubleKeyFrame.KeySpline>
                                                    </SplineDoubleKeyFrame>
                                                    <SplineDoubleKeyFrame KeyTime="0:0:0.2" Value="1.0">
                                                        <SplineDoubleKeyFrame.KeySpline>
                                                            <KeySpline ControlPoint1="0.2,1" ControlPoint2="0.4,1"/>
                                                        </SplineDoubleKeyFrame.KeySpline>
                                                    </SplineDoubleKeyFrame>
                                                </DoubleAnimationUsingKeyFrames.KeyFrames>
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CheckBackground"
                                                                           Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                                                <DoubleAnimationUsingKeyFrames.KeyFrames>
                                                    <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1.0"/>
                                                    <SplineDoubleKeyFrame KeyTime="0:0:0.08" Value="1.15">
                                                        <SplineDoubleKeyFrame.KeySpline>
                                                            <KeySpline ControlPoint1="0.2,1" ControlPoint2="0.4,1"/>
                                                        </SplineDoubleKeyFrame.KeySpline>
                                                    </SplineDoubleKeyFrame>
                                                    <SplineDoubleKeyFrame KeyTime="0:0:0.2" Value="1.0">
                                                        <SplineDoubleKeyFrame.KeySpline>
                                                            <KeySpline ControlPoint1="0.2,1" ControlPoint2="0.4,1"/>
                                                        </SplineDoubleKeyFrame.KeySpline>
                                                    </SplineDoubleKeyFrame>
                                                </DoubleAnimationUsingKeyFrames.KeyFrames>
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Unchecked">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CheckBackground" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ControlFillBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CheckBackground" Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ControlBorderBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CheckGlyph" Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Collapsed"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Indeterminate"/>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver"/>
                                    <VisualState x:Name="Pressed"/>
                                    <VisualState x:Name="Disabled"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Storyboard x:Key="HoverInStoryboard">
            <DoubleAnimation Storyboard.TargetName="CardScale"
                             Storyboard.TargetProperty="ScaleX"
                             To="1.008"
                             Duration="0:0:0.16">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CardScale"
                             Storyboard.TargetProperty="ScaleY"
                             To="1.008"
                             Duration="0:0:0.16">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Key="HoverOutStoryboard">
            <DoubleAnimation Storyboard.TargetName="CardScale"
                             Storyboard.TargetProperty="ScaleX"
                             To="1"
                             Duration="0:0:0.14">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CardScale"
                             Storyboard.TargetProperty="ScaleY"
                             To="1"
                             Duration="0:0:0.14">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>

    <Border x:Name="CardBorder"
            Background="{ThemeResource ControlFillBrush}"
            CornerRadius="8"
            BorderBrush="{ThemeResource CardBorderBrush}"
            BorderThickness="1"
            Padding="16,14"
            Margin="0,0,0,8">
        <Border.RenderTransform>
            <ScaleTransform x:Name="CardScale"/>
        </Border.RenderTransform>
        <Grid x:Name="RootGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <CheckBox
                Grid.Column="0"
                x:Name="SelectionCheckBox"
                Visibility="Collapsed"
                Click="OnSelectionChanged"
                Tapped="OnInteractiveChildTapped"
                PointerPressed="OnInteractiveChildPointerPressed"
                VerticalAlignment="Center"
                AutomationProperties.Name="选择任务"
                Margin="0,0,10,0"/>

            <Border
                Grid.Column="1"
                Width="4"
                CornerRadius="2"
                x:Name="PriorityBar"
                VerticalAlignment="Stretch"
                Margin="0,1,12,1"/>

            <StackPanel Grid.Column="2" Spacing="6">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <CheckBox
                        Grid.Column="0"
                        x:Name="CompleteCheckBox"
                        Style="{StaticResource TaskCompleteCheckBoxStyle}"
                        Click="OnToggleComplete"
                        Tapped="OnInteractiveChildTapped"
                        PointerPressed="OnInteractiveChildPointerPressed"
                        AutomationProperties.Name="切换任务完成状态"
                        VerticalAlignment="Top"
                        Margin="0,1,0,0"/>

                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock
                            x:Name="TitleText"
                            FontSize="15"
                            FontWeight="SemiBold"
                            TextTrimming="CharacterEllipsis"
                            DoubleTapped="OnTitleDoubleTapped"/>

                        <TextBox
                            x:Name="TitleEditBox"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Visibility="Collapsed"
                            KeyDown="OnTitleEditKeyDown"
                            LostFocus="OnTitleEditLostFocus"
                            PlaceholderText="输入任务标题..."/>

                        <Border
                            x:Name="OverdueBadge"
                            HorizontalAlignment="Left"
                            CornerRadius="10"
                            Padding="8,3"
                            Visibility="Collapsed">
                            <TextBlock x:Name="OverdueText" FontSize="12"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <StackPanel
                    x:Name="MetadataRow"
                    Orientation="Horizontal"
                    Spacing="12"
                    Margin="32,0,0,0"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="SubtaskText"
                        FontSize="11"
                        Foreground="{ThemeResource SecondaryTextBrush}"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"/>
                    <TextBlock
                        x:Name="TagsText"
                        FontSize="11"
                        Foreground="{ThemeResource SecondaryTextBrush}"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"/>
                    <FontIcon
                        x:Name="RecurringIcon"
                        Glyph="&#xE777;"
                        FontSize="12"
                        Foreground="{ThemeResource SecondaryTextBrush}"
                        Visibility="Collapsed"/>
                </StackPanel>
            </StackPanel>

            <StackPanel
                Grid.Column="3"
                Orientation="Horizontal"
                Spacing="6"
                VerticalAlignment="Center"
                Margin="16,0,0,0">
                <FontIcon
                    x:Name="DateIcon"
                    Glyph="&#xE787;"
                    FontSize="14"
                    Foreground="{ThemeResource SecondaryTextBrush}"/>
                <TextBlock
                    x:Name="DateRightText"
                    FontSize="14"
                    Foreground="{ThemeResource SecondaryTextBrush}"
                    VerticalAlignment="Center"/>
            </StackPanel>

            <Button
                Grid.Column="4"
                x:Name="DeleteButton"
                Content="&#xE74D;"
                FontFamily="Segoe MDL2 Assets"
                FontSize="14"
                Padding="4"
                Background="Transparent"
                Click="OnDelete"
                Tapped="OnInteractiveChildTapped"
                PointerPressed="OnInteractiveChildPointerPressed"
                ToolTipService.ToolTip="删除"
                AutomationProperties.Name="删除任务"
                VerticalAlignment="Center"
                Margin="8,0,0,0"
                Visibility="Collapsed"/>
        </Grid>
    </Border>
</UserControl>
