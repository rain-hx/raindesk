<UserControl x:Class="rainspace.Controls.SimpleColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="250">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 预设颜色 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5" Spacing="2">
            <Button Width="25" Height="25" MinWidth="44" MinHeight="44" Margin="2" Click="PresetColor_Click" Tag="#FF0000" AutomationProperties.Name="红色">
                <Button.Background><SolidColorBrush Color="#FF0000"/></Button.Background>
            </Button>
            <Button Width="25" Height="25" MinWidth="44" MinHeight="44" Margin="2" Click="PresetColor_Click" Tag="#FF4500" AutomationProperties.Name="橙红色">
                <Button.Background><SolidColorBrush Color="#FF4500"/></Button.Background>
            </Button>
            <Button Width="25" Height="25" MinWidth="44" MinHeight="44" Margin="2" Click="PresetColor_Click" Tag="#FFA500" AutomationProperties.Name="橙色">
                <Button.Background><SolidColorBrush Color="#FFA500"/></Button.Background>
            </Button>
            <Button Width="25" Height="25" MinWidth="44" MinHeight="44" Margin="2" Click="PresetColor_Click" Tag="#FFD700" AutomationProperties.Name="金色">
                <Button.Background><SolidColorBrush Color="#FFD700"/></Button.Background>
            </Button>
            <Button Width="25" Height="25" MinWidth="44" MinHeight="44" Margin="2" Click="PresetColor_Click" Tag="#32CD32" AutomationProperties.Name="酸橙绿">
                <Button.Background><SolidColorBrush Color="#32CD32"/></Button.Background>
            </Button>
            <Button Width="25" Height="25" MinWidth="44" MinHeight="44" Margin="2" Click="PresetColor_Click" Tag="#00CED1" AutomationProperties.Name="深青色">
                <Button.Background><SolidColorBrush Color="#00CED1"/></Button.Background>
            </Button>
            <Button Width="25" Height="25" MinWidth="44" MinHeight="44" Margin="2" Click="PresetColor_Click" Tag="#1E90FF" AutomationProperties.Name="道奇蓝">
                <Button.Background><SolidColorBrush Color="#1E90FF"/></Button.Background>
            </Button>
            <Button Width="25" Height="25" MinWidth="44" MinHeight="44" Margin="2" Click="PresetColor_Click" Tag="#8A2BE2" AutomationProperties.Name="蓝紫色">
                <Button.Background><SolidColorBrush Color="#8A2BE2"/></Button.Background>
            </Button>
            <Button Width="25" Height="25" MinWidth="44" MinHeight="44" Margin="2" Click="PresetColor_Click" Tag="#FF69B4" AutomationProperties.Name="粉红色">
                <Button.Background><SolidColorBrush Color="#FF69B4"/></Button.Background>
            </Button>
            <Button Width="25" Height="25" MinWidth="44" MinHeight="44" Margin="2" Click="PresetColor_Click" Tag="#000000" AutomationProperties.Name="黑色">
                <Button.Background><SolidColorBrush Color="#000000"/></Button.Background>
            </Button>
            <Button Width="25" Height="25" MinWidth="44" MinHeight="44" Margin="2" Click="PresetColor_Click" Tag="#808080" AutomationProperties.Name="灰色">
                <Button.Background><SolidColorBrush Color="#808080"/></Button.Background>
            </Button>
            <Button Width="25" Height="25" MinWidth="44" MinHeight="44" Margin="2" Click="PresetColor_Click" Tag="#FFFFFF" BorderBrush="{ThemeResource ControlBorderBrush}" BorderThickness="1" AutomationProperties.Name="白色">
                <Button.Background><SolidColorBrush Color="#FFFFFF"/></Button.Background>
            </Button>
        </StackPanel>

        <!-- 颜色预览 -->
        <Border Grid.Row="1" x:Name="ColorPreview" Background="{ThemeResource ControlFillBrush}" Margin="10" CornerRadius="4" Height="50"/>

        <!-- HEX 输入 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="10,5">
            <TextBlock Text="HEX:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="HexInput" Width="100" Text="#FFFFFF" VerticalContentAlignment="Center"/>
        </StackPanel>

        <!-- 按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10,5">
            <Button Content="确定" Width="60" Margin="5,0" Click="Confirm_Click" AutomationProperties.Name="确定"/>
            <Button Content="取消" Width="60" Margin="5,0" Click="Cancel_Click" AutomationProperties.Name="取消"/>
        </StackPanel>
    </Grid>
</UserControl>
