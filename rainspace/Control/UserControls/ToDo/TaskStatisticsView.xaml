<UserControl
    x:Class="rainspace.Control.UserControls.ToDo.TaskStatisticsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Padding="16">
            <!-- 概览卡片 -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{ThemeResource CardBackgroundBrush}" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="总任务" FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}"/>
                        <TextBlock x:Name="TotalCountText" FontSize="24" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="{ThemeResource CardBackgroundBrush}" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="进行中" FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}"/>
                        <TextBlock x:Name="ActiveCountText" FontSize="24" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{ThemeResource CardBackgroundBrush}" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="已完成" FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}"/>
                        <TextBlock x:Name="CompletedCountText" FontSize="24" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Background="{ThemeResource CardBackgroundBrush}" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="已过期" FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}"/>
                        <TextBlock x:Name="OverdueCountText" FontSize="24" FontWeight="Bold" Foreground="#E74C3C"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 完成率 -->
            <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="8" Padding="16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="完成率" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock x:Name="CompletionRateText" FontSize="16" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ProgressBar x:Name="CompletionRateBar" Maximum="100" Height="8" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- 完成趋势图（自定义柱状图） -->
            <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock Text="最近7天完成趋势" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <Grid x:Name="TrendChart" Height="160">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Canvas x:Name="TrendCanvas" Grid.Row="0"/>
                        <StackPanel x:Name="TrendLabels" Grid.Row="1" Orientation="Horizontal" Spacing="0"/>
                    </Grid>
                    <TextBlock x:Name="TrendEmptyText" Text="暂无完成记录" FontSize="12"
                               Foreground="{ThemeResource SecondaryTextBrush}"
                               HorizontalAlignment="Center" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- 优先级分布 -->
            <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock Text="优先级分布" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <StackPanel x:Name="PriorityChart" Spacing="8"/>
                    <TextBlock x:Name="PriorityEmptyText" Text="暂无任务" FontSize="12"
                               Foreground="{ThemeResource SecondaryTextBrush}"
                               HorizontalAlignment="Center" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- 项目分布 -->
            <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock Text="项目任务分布" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <StackPanel x:Name="ProjectChart" Spacing="8"/>
                    <TextBlock x:Name="ProjectEmptyText" Text="暂无项目任务" FontSize="12"
                               Foreground="{ThemeResource SecondaryTextBrush}"
                               HorizontalAlignment="Center" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
