<UserControl x:Class="rainspace.Control.UserControls.Backlog.TodoControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewmodel="using:rainspace.ViewModel"
             mc:Ignorable="d"
             Background="Transparent">

    <Grid Margin="16" Background="Transparent">
        <Grid.ContextFlyout>
            <MenuFlyout x:Name="Menu" Placement="Bottom">
                <MenuFlyoutItem Text="详情" Click="DetailMenu_Click"/>
                <MenuFlyoutItem Text="删除" Click="DeleteMenu_Click"/>
            </MenuFlyout>
        </Grid.ContextFlyout>
        <Grid Background="Transparent">
            <TextBlock x:Name="IsNewToDo" x:FieldModifier="public" Visibility="Collapsed"/>
            <TextBlock x:Name="NoData" x:FieldModifier="public"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Text="暂无数据!"
                       FontSize="14"
                       Foreground="{ThemeResource SecondaryTextBrush}"/>

            <!-- Todo list -->
            <ListView x:Name="BacklogListView" x:FieldModifier="public"
                      ItemsSource="{Binding}"
                      SelectionMode="Single"
                      ShowsScrollingPlaceholders="False"
                      RightTapped="BacklogListView_RightTapped"
                      Background="Transparent"
                      Padding="0,4,0,0">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="12,8" Margin="0,0,0,4" CornerRadius="8"
                              Background="{ThemeResource SubtleBrush}"
                              PointerEntered="Row_PointerEntered"
                              PointerExited="Row_PointerExited">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto" MinWidth="120"/>
                                <ColumnDefinition Width="Auto" MinWidth="120"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Title}" TextAlignment="Center"
                                       VerticalAlignment="Center" FontSize="13"
                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource AppForegroundBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Msg}" TextAlignment="Center"
                                       VerticalAlignment="Center" FontSize="13"
                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource AppForegroundBrush}"/>
                            <TextBlock Grid.Column="2" Text="{Binding ExeTime}" TextAlignment="Center"
                                       VerticalAlignment="Center" FontSize="13"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource SecondaryTextBrush}"/>
                            <TextBlock Grid.Column="3" Text="{Binding DoneTime}" TextAlignment="Center"
                                       VerticalAlignment="Center" FontSize="13"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource SecondaryTextBrush}"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel VerticalAlignment="Center" Margin="0,10,10,50"/>
        </Grid>
    </Grid>
</UserControl>
