<UserControl x:Class="rainspace.Control.UserControls.Config.MotionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:cst="using:rainspace.Constant"
             mc:Ignorable="d"
             Background="Transparent"
             d:DesignHeight="640"
             d:DesignWidth="820">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14">
            <Border Style="{StaticResource rainspacePanelStyle}" Padding="20">
                <StackPanel Spacing="22">
                    <TextBlock Text="常规动作" Style="{StaticResource SectionHeaderStyle}" FontSize="17"/>
                    <Grid RowSpacing="24" ColumnSpacing="80">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="启动时显示主面板"
                                       VerticalAlignment="Center"
                                       FontSize="14"
                                       Foreground="{ThemeResource AppForegroundBrush}"/>
                            <ToggleSwitch Grid.Column="1"
                                          IsOn="{Binding StartedShowPanel, Mode=TwoWay}"
                                          OffContent=""
                                          OnContent=""
                                          AutomationProperties.Name="启动时显示主面板"/>
                        </Grid>
                        <Grid Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="显示时追随鼠标位置"
                                       VerticalAlignment="Center"
                                       FontSize="14"
                                       Foreground="{ThemeResource AppForegroundBrush}"/>
                            <ToggleSwitch Grid.Column="1"
                                          IsOn="{Binding FollowMouse, Mode=TwoWay}"
                                          OffContent=""
                                          OnContent=""
                                          AutomationProperties.Name="显示时追随鼠标位置"/>
                        </Grid>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="双击启动"
                                       VerticalAlignment="Center"
                                       FontSize="14"
                                       Foreground="{ThemeResource AppForegroundBrush}"/>
                            <ToggleSwitch Grid.Column="1"
                                          IsOn="{Binding DoubleOpen, Mode=TwoWay}"
                                          OffContent=""
                                          OnContent=""
                                          AutomationProperties.Name="双击启动"/>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource rainspacePanelStyle}" Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="面板关闭方式" Style="{StaticResource SectionHeaderStyle}" FontSize="17"/>
                    <Grid MinHeight="44">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <RadioButton Content="失去焦点后"
                                     HorizontalAlignment="Center"
                                     Style="{StaticResource MyRadioBtnStyle}"
                                     IsChecked="{Binding AppHideType, Mode=TwoWay, Converter={StaticResource HideTypeConvert}, ConverterParameter=1}"
                                     AutomationProperties.Name="失去焦点后关闭"/>
                        <RadioButton Grid.Column="1"
                                     Content="运行项目后"
                                     HorizontalAlignment="Center"
                                     Style="{StaticResource MyRadioBtnStyle}"
                                     IsChecked="{Binding AppHideType, Mode=TwoWay, Converter={StaticResource HideTypeConvert}, ConverterParameter=2}"
                                     AutomationProperties.Name="运行项目后关闭"/>
                        <RadioButton Grid.Column="2"
                                     Content="手动关闭"
                                     HorizontalAlignment="Center"
                                     Style="{StaticResource MyRadioBtnStyle}"
                                     AutomationProperties.Name="手动关闭"
                                     IsChecked="{Binding AppHideType, Mode=TwoWay, Converter={StaticResource HideTypeConvert}, ConverterParameter=3}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource rainspacePanelStyle}" Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="热键设置" Style="{StaticResource SectionHeaderStyle}" FontSize="17"/>
                    <TextBlock Text="设置后立即生效并自动保存。"
                               Foreground="{ThemeResource SecondaryTextBrush}"
                               FontSize="13"
                               TextWrapping="Wrap"/>
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="120"/>
                            <ColumnDefinition Width="Auto" MinWidth="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="主面板" VerticalAlignment="Center" FontSize="15"/>
                        <TextBox Grid.Column="1"
                                 x:Name="MainHotkeyBox"
                                 Style="{StaticResource HotkeyTextBoxStyle}"
                                 Tag="Main"
                                 PlaceholderText="点击后按下快捷键"
                                 Text="{Binding HotkeyStr, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewKeyDown="HotKeyDown"
                                 PreviewKeyUp="HotKeyUp"
                                 KeyDown="HotKeyDown"
                                 KeyUp="HotKeyUp"
                                 GotFocus="HotkeyBox_GotFocus"
                                 LostFocus="HotkeyBox_LostFocus"
                                 PointerPressed="HotkeyBox_PointerPressed"
                                 AutomationProperties.Name="主面板热键"/>
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <TextBlock Text="启用"
                                       VerticalAlignment="Center"
                                       FontSize="14"
                                       Foreground="{ThemeResource AppForegroundBrush}"/>
                            <ToggleSwitch IsOn="{Binding EnableAppHotKey, Mode=TwoWay}"
                                          Toggled="EnableHotKey_Click"
                                          Tag="Main"
                                          OffContent=""
                                          OnContent=""
                                          AutomationProperties.Name="启用主面板热键"/>
                        </StackPanel>

                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
