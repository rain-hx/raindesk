<UserControl x:Class="rainspace.Control.Other.IconInfoDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:cvt="using:rainspace.Converts"
             mc:Ignorable="d"
             Width="540" Height="560">

    <UserControl.Resources>
        <cvt:StringAppendConvert x:Key="StringAppendConvert"/>
    </UserControl.Resources>

    <Border Style="{StaticResource BorderBG}" CornerRadius="14" Padding="28">
        <Grid RowSpacing="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="76"
                        Height="76"
                        CornerRadius="22"
                        Background="{ThemeResource CardHoverBrush}"
                        BorderBrush="{ThemeResource CardBorderBrush}"
                        BorderThickness="1">
                    <Image x:Name="IconImg"
                           Width="44"
                           Height="44"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="4">
                    <TextBlock Text="快捷方式属性"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource AppForegroundBrush}"/>
                    <TextBlock Text="修改名称、图标、启动方式和参数"
                               FontSize="13"
                               Foreground="{ThemeResource SecondaryTextBrush}"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1" Spacing="18">
                <StackPanel Spacing="8">
                    <TextBlock Text="名称" FontSize="14" Foreground="{ThemeResource AppForegroundBrush}"/>
                    <TextBox x:Name="IconName"
                             Style="{StaticResource MyTextBoxStyle}"
                             Text="{Binding Name, Mode=OneWay}"
                             Height="44"
                             PlaceholderText="快捷方式名称"
                             AutomationProperties.Name="快捷方式名称"/>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="相对路径" FontSize="14" Foreground="{ThemeResource AppForegroundBrush}"/>
                    <Border Background="{ThemeResource SubtleBrush}"
                            BorderBrush="{ThemeResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12,10">
                        <TextBlock Text="{Binding RelativePath, Mode=OneWay}"
                                   FontSize="13"
                                   Foreground="{ThemeResource SecondaryTextBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTipService.Placement="Bottom">
                            <ToolTipService.ToolTip>
                                <ToolTip Content="{Binding RelativePath, Mode=OneWay, Converter={StaticResource StringAppendConvert}, ConverterParameter='{}\n(同盘符下才会建立相对路径)'}"/>
                            </ToolTipService.ToolTip>
                        </TextBlock>
                    </Border>
                </StackPanel>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="图标" FontSize="14" Foreground="{ThemeResource AppForegroundBrush}"/>
                        <TextBlock Text="支持从本地文件重新提取图标"
                                   FontSize="13"
                                   Foreground="{ThemeResource SecondaryTextBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Style="{StaticResource rainspaceCommandButtonStyle}"
                            Click="EditImage"
                            MinHeight="44"
                            AutomationProperties.Name="修改图标">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE790;" FontSize="14"/>
                            <TextBlock Text="修改"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2"
                            Style="{StaticResource rainspaceCommandButtonStyle}"
                            Click="ReStoreImage"
                            MinHeight="44"
                            AutomationProperties.Name="重置图标">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE777;" FontSize="14"/>
                            <TextBlock Text="重置"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <CheckBox x:Name="IconIsAdmin"
                          Style="{StaticResource MyCheckBoxStyle}"
                          Content="始终以管理员方式启动"
                          IsChecked="{Binding AdminStartUp, Mode=OneWay}"
                          AutomationProperties.Name="管理员模式启动"/>

                <StackPanel Spacing="8">
                    <TextBlock Text="启动参数" FontSize="14" Foreground="{ThemeResource AppForegroundBrush}"/>
                    <TextBox x:Name="StartArg"
                             Style="{StaticResource MyTextBoxStyle}"
                             Text="{Binding StartArgument, Mode=OneWay}"
                             Height="92"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             PlaceholderText="可选"
                             AutomationProperties.Name="启动参数"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="12">
                <Button Content="取消"
                        Style="{StaticResource rainspaceCommandButtonStyle}"
                        MinWidth="96"
                        MinHeight="44"
                        Click="Cancel_Click"/>
                <Button Content="保存"
                        Style="{StaticResource rainspacePrimaryButtonStyle}"
                        MinWidth="112"
                        MinHeight="44"
                        Click="SaveProperty"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
