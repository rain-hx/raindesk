<UserControl x:Class="rainspace.Control.Other.MyColorPickerDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Width="350" Height="320">

    <Border Style="{StaticResource BorderBG}" CornerRadius="8" Padding="15">
        <StackPanel>
            <TextBlock Text="选择颜色" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="颜色值:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="ColorTextBox"
                         Style="{StaticResource MyTextBoxStyle}"
                         Width="150"
                         VerticalAlignment="Center"
                         Text="#FF000000"
                         AutomationProperties.Name="颜色值输入框"/>
            </StackPanel>

            <TextBlock Text="预设颜色:" Margin="0,0,0,5"/>
            <VariableSizedWrapGrid x:Name="PresetColors"
                                   Margin="0,0,0,10"
                                   HorizontalAlignment="Center"
                                   ItemWidth="34" ItemHeight="34"
                                   MaximumRowsOrColumns="6">
                <Button Margin="2" Click="PresetColor_Click" Tag="#FF0000" BorderThickness="1" BorderBrush="{ThemeResource ControlBorderBrush}" AutomationProperties.Name="红色">
                    <Button.Background><SolidColorBrush Color="#FF0000"/></Button.Background>
                </Button>
                <Button Margin="2" Click="PresetColor_Click" Tag="#FFFF00" BorderThickness="1" BorderBrush="{ThemeResource ControlBorderBrush}" AutomationProperties.Name="黄色">
                    <Button.Background><SolidColorBrush Color="#FFFF00"/></Button.Background>
                </Button>
                <Button Margin="2" Click="PresetColor_Click" Tag="#FF00FF" BorderThickness="1" BorderBrush="{ThemeResource ControlBorderBrush}" AutomationProperties.Name="品红">
                    <Button.Background><SolidColorBrush Color="#FF00FF"/></Button.Background>
                </Button>
                <Button Margin="2" Click="PresetColor_Click" Tag="#00FF00" BorderThickness="1" BorderBrush="{ThemeResource ControlBorderBrush}" AutomationProperties.Name="绿色">
                    <Button.Background><SolidColorBrush Color="#00FF00"/></Button.Background>
                </Button>
                <Button Margin="2" Click="PresetColor_Click" Tag="#0000FF" BorderThickness="1" BorderBrush="{ThemeResource ControlBorderBrush}" AutomationProperties.Name="蓝色">
                    <Button.Background><SolidColorBrush Color="#0000FF"/></Button.Background>
                </Button>
                <Button Margin="2" Click="PresetColor_Click" Tag="#00FFFF" BorderThickness="1" BorderBrush="{ThemeResource ControlBorderBrush}" AutomationProperties.Name="青色">
                    <Button.Background><SolidColorBrush Color="#00FFFF"/></Button.Background>
                </Button>
                <Button Margin="2" Click="PresetColor_Click" Tag="#FF8800" BorderThickness="1" BorderBrush="{ThemeResource ControlBorderBrush}" AutomationProperties.Name="橙色">
                    <Button.Background><SolidColorBrush Color="#FF8800"/></Button.Background>
                </Button>
                <Button Margin="2" Click="PresetColor_Click" Tag="#8800FF" BorderThickness="1" BorderBrush="{ThemeResource ControlBorderBrush}" AutomationProperties.Name="紫色">
                    <Button.Background><SolidColorBrush Color="#8800FF"/></Button.Background>
                </Button>
                <Button Margin="2" Click="PresetColor_Click" Tag="#FFFFFF" BorderThickness="1" BorderBrush="{ThemeResource ControlBorderBrush}" AutomationProperties.Name="白色">
                    <Button.Background><SolidColorBrush Color="#FFFFFF"/></Button.Background>
                </Button>
                <Button Margin="2" Click="PresetColor_Click" Tag="#000000" BorderThickness="1" BorderBrush="{ThemeResource ControlBorderBrush}" AutomationProperties.Name="黑色">
                    <Button.Background><SolidColorBrush Color="#000000"/></Button.Background>
                </Button>
                <Button Margin="2" Click="PresetColor_Click" Tag="#808080" BorderThickness="1" BorderBrush="{ThemeResource ControlBorderBrush}" AutomationProperties.Name="灰色">
                    <Button.Background><SolidColorBrush Color="#808080"/></Button.Background>
                </Button>
                <Button Margin="2" Click="PresetColor_Click" Tag="#C0C0C0" BorderThickness="1" BorderBrush="{ThemeResource ControlBorderBrush}" AutomationProperties.Name="银色">
                    <Button.Background><SolidColorBrush Color="#C0C0C0"/></Button.Background>
                </Button>
            </VariableSizedWrapGrid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="确认"
                        Style="{StaticResource MyBtnStyle}"
                        Click="Confirm_Click"
                        Margin="0,0,10,0"
                        MinHeight="44"
                        AutomationProperties.Name="确认选择"/>
                <Button Content="取消"
                        Style="{StaticResource MyBtnStyle}"
                        Click="Cancel_Click"
                        MinHeight="44"
                        AutomationProperties.Name="取消选择"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
