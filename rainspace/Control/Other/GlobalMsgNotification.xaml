<UserControl x:Class="rainspace.Control.Other.GlobalMsgNotification"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">
    <Border BorderThickness="0"
            Margin="15"
            Width="320"
            Height="400"
            Background="{ThemeResource CardBackgroundBrush}">
        <Grid>

            <StackPanel>
                <Image Source="ms-appx:///Resource/Image/BacklogImg.png" Width="260" Margin="0,20,0,0"/>
                <Border CornerRadius="4" Width="260" Height="220" BorderThickness="0" Margin="0,20,0,0">

                <Border CornerRadius="4,4,0,0" Height="160" Padding="10,0,10,0">
                        <ScrollViewer>
                            <TextBlock TextWrapping="Wrap"
                                       FontStyle="Normal"
                                       FontSize="15"
                                       LineHeight="22"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Text="{Binding Msg}"/>
                        </ScrollViewer>
                </Border>


                </Border>
            </StackPanel>

            <Button Click="Close_Click" Content="朕已阅" Margin="10,0,10,20" Width="298" MinHeight="44" VerticalAlignment="Bottom"
                    AutomationProperties.Name="关闭通知"/>
        </Grid>
    </Border>
</UserControl>
