<Window
    x:Class="rainspace.Control.Windows.PixelColorPickerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    >
    <!-- WinUI 3: WindowStyle/AllowsTransparency/ResizeMode removed (handled via AppWindow APIs) -->
    <!-- WinUI 3: PreviewMouseMove->PointerMoved, MouseLeftButtonDown->PointerPressed, MouseRightButtonDown->RightTapped, MouseWheel->PointerWheelChanged -->
    <Grid>
        <Grid.Resources>
            <Style x:Key="TextKey" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{ThemeResource SecondaryTextBrush}"/>
            </Style>
            <Style x:Key="TextValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Margin" Value="10,0,0,0"/>
                <Setter Property="Foreground" Value="{ThemeResource AppForegroundBrush}"/>
            </Style>
        </Grid.Resources>
        <Image x:Name="DesktopBG"/>

        <Canvas HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent"
                PointerMoved="Window_PreviewMouseMove"
                PointerPressed="Window_MouseLeftButtonDown"
                RightTapped="Window_MouseRightButtonDown"
                PointerWheelChanged="Window_MouseWheel">
            <Canvas x:Name="ColorCanvas" Width="185" Height="160">
                <Border Background="{ThemeResource CardBackgroundBrush}"
                        CornerRadius="8"
                        BorderBrush="{ThemeResource CardBorderBrush}"
                        BorderThickness="1"
                        Padding="4">
                    <Border.Shadow>
                        <ThemeShadow/>
                    </Border.Shadow>
                    <Grid>
                        <!-- Color preview + magnifier -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                    Height="70" Margin="0,5,0,80">
                            <Border Width="70" Height="70"
                                    BorderBrush="{ThemeResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <Rectangle x:Name="PixelColor" StrokeThickness="0">
                                    <Rectangle.Fill>
                                        <SolidColorBrush />
                                    </Rectangle.Fill>
                                </Rectangle>
                            </Border>
                            <!-- Magnifier view -->
                            <Border x:Name="Pixel"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Width="70" Height="70"
                                    Background="Black"
                                    BorderBrush="{ThemeResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Margin="20,0,0,0">
                                <Grid>
                                    <Image x:Name="PixelBG" Stretch="None"/>
                                    <Border HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Width="6" Height="6"
                                            BorderBrush="White" BorderThickness="0.6">
                                        <Border Width="4.5" Height="4.5"
                                                BorderBrush="Black" BorderThickness="0.6"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Color info -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                    Height="80" Margin="0,85,0,5">
                            <StackPanel Width="100" Height="80">
                                <TextBlock Text="RGB:" Style="{StaticResource TextKey}"/>
                                <TextBlock x:Name="PixelColor_RGB" Style="{StaticResource TextValue}"/>
                                <TextBlock Text="HTML:" Margin="0,5,0,0" Style="{StaticResource TextKey}"/>
                                <TextBlock x:Name="PixelColor_HTML" Style="{StaticResource TextValue}"/>
                            </StackPanel>
                            <StackPanel Width="65" Height="80" Margin="10,0,0,0">
                                <TextBlock x:Name="Pixel_XY" TextAlignment="Right"
                                           Foreground="{ThemeResource SecondaryTextBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Canvas>
        </Canvas>
    </Grid>
</Window>
