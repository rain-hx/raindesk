<Window x:Class="rainspace.Control.Windows.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:rainspace.Control.Windows"
        mc:Ignorable="d"
        Title="">
    <!-- WinUI 3: Height/Width/Focusable/KeyDown moved to code-behind -->
    <Grid Margin="24">
        <Border CornerRadius="12"
                Background="{ThemeResource CardBackgroundBrush}"
                BorderBrush="{ThemeResource CardBorderBrush}"
                BorderThickness="1"
                Padding="24">
            <Border.Shadow>
                <ThemeShadow/>
            </Border.Shadow>
            <StackPanel HorizontalAlignment="Center">
                <!-- Header area -->
                <Border CornerRadius="8" Padding="0" BorderThickness="0" Background="Transparent">
                    <StackPanel>
                        <Grid VerticalAlignment="Center">
                            <TextBlock Margin="0,0,0,12" x:Name="MsgTitle"
                                       TextWrapping="Wrap"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource AppForegroundBrush}"
                                       HorizontalAlignment="Left"
                                       Text="测试"/>
                            <Button HorizontalAlignment="Right" Margin="0,0,0,12"
                                    Content="去点个Star" Click="StarBtnClick"
                                    Style="{StaticResource AccentBtnStyle}"
                                    AutomationProperties.Name="去点个Star"/>
                        </Grid>
                        <Border Margin="0,0,0,12" Height="1" Background="{ThemeResource DividerBrush}"/>
                        <ScrollViewer BorderThickness="0" Padding="0,4" Height="225">
                            <StackPanel x:Name="MsgPanel">
                                <TextBlock Width="430" FontSize="14" LineHeight="24"
                                           x:Name="Msg" TextWrapping="Wrap"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource AppForegroundBrush}"
                                           Text="测试"/>
                            </StackPanel>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- Footer area -->
                <StackPanel Margin="0,16,0,0" Width="520">
                    <TextBlock TextWrapping="NoWrap" x:Name="TitleText"
                               TextTrimming="CharacterEllipsis" Text=""
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{ThemeResource AppForegroundBrush}"
                               HorizontalAlignment="Left"/>
                    <TextBlock TextWrapping="NoWrap" x:Name="SubTitle"
                               TextTrimming="CharacterEllipsis" Margin="0,4,0,0"
                               FontSize="13"
                               Foreground="{ThemeResource SecondaryTextBrush}"
                               HorizontalAlignment="Left"/>
                </StackPanel>

                <!-- Action buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0" Spacing="16">
                    <Button Content="暂不更新" Click="Close_Click"
                            Style="{StaticResource MyBtnStyle}"
                            AutomationProperties.Name="暂不更新"/>
                    <Button Content="前往更新" Click="Confirm_Click"
                            Style="{StaticResource AccentBtnStyle}"
                            AutomationProperties.Name="前往更新"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
