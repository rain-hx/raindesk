<Window x:Class="rainspace.Control.Windows.ToDoInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:rainspace"
        mc:Ignorable="d"
        Title=""
        >
    <!-- WinUI 3: WindowStyle/AllowsTransparency/Background=Transparent/ResizeMode/ShowInTaskbar/WindowStartupLocation removed -->

    <Grid Margin="20">
        <Grid.Resources>
        </Grid.Resources>
        <Border Background="{ThemeResource AppBackgroundBrush}" CornerRadius="12" Opacity="0.4" Margin="-4"/>
        <Border Style="{StaticResource BorderBG}" PointerPressed="DragMove">
            <Border.Resources>
                <Style x:Key="LeftTB" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                    <Setter Property="Width" Value="72"/>
                    <Setter Property="Margin" Value="0,6,0,0"/>
                    <Setter Property="HorizontalAlignment" Value="Left"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="TextAlignment" Value="Center"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="Foreground" Value="{ThemeResource SecondaryTextBrush}"/>
                </Style>
            </Border.Resources>
            <Grid Margin="0,16,0,0">
                <StackPanel Margin="24" HorizontalAlignment="Center">
                    <!-- Task title -->
                    <StackPanel Orientation="Horizontal" Grid.ColumnSpan="4">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="待办任务:" Style="{StaticResource LeftTB}"/>
                            <TextBlock Text="*" Foreground="{ThemeResource rainspaceRedBrush}"/>
                        </StackPanel>
                        <TextBox x:Name="TitleBox" Style="{StaticResource MyTextBoxStyle}"
                                 Width="290" Text="{Binding Title, Mode=OneWay}"
                                 FontSize="14" Margin="10,0,0,0"/>
                    </StackPanel>

                    <!-- Task detail -->
                    <StackPanel Orientation="Horizontal" Grid.ColumnSpan="4" Margin="0,12,0,0">
                        <TextBlock Text="待办详情:" Style="{StaticResource LeftTB}"/>
                        <TextBox x:Name="Msg" TextWrapping="Wrap"
                                 Style="{StaticResource MyTextBoxStyle}"
                                 Margin="15,0,0,0"
                                 Text="{Binding Msg, Mode=OneWay}"
                                 AcceptsReturn="True"
                                 Height="100" MaxHeight="150" MinHeight="100"
                                 Width="290" MinWidth="290"
                                 VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Execution type -->
                    <StackPanel Orientation="Horizontal" Grid.ColumnSpan="4" Margin="0,12,0,0">
                        <TextBlock Text="运行方式:" Style="{StaticResource LeftTB}"/>
                        <RadioButton Margin="20,0,0,0" Checked="ExecType_Checked" Tag="1"
                                     Style="{StaticResource MyRadioBtnStyle}" Content="指定时间"
                                     IsChecked="{Binding ExecType, Mode=OneWay, Converter={StaticResource TodoTaskExecConvert}, ConverterParameter=1}"/>
                        <RadioButton Margin="12,0,0,0" Checked="ExecType_Checked" Tag="2"
                                     Style="{StaticResource MyRadioBtnStyle}" Content="CRON表达式"
                                     IsChecked="{Binding ExecType, Mode=OneWay, Converter={StaticResource TodoTaskExecConvert}, ConverterParameter=2}"/>
                    </StackPanel>

                    <!-- Set time panel -->
                    <StackPanel Orientation="Horizontal" x:Name="SetTimePanel" Height="36"
                                Visibility="Visible" Grid.ColumnSpan="4" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="指定时间:" Style="{StaticResource LeftTB}"/>
                            <TextBlock Text="*" Foreground="{ThemeResource rainspaceRedBrush}"/>
                        </StackPanel>
                        <DatePicker x:Name="ExeTime" Width="200" Margin="12,0,0,0"/>
                    </StackPanel>

                    <!-- CRON panel -->
                    <StackPanel Orientation="Horizontal" x:Name="CronPanel" Height="36"
                                Visibility="Collapsed" Grid.ColumnSpan="4" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="CRON:" Style="{StaticResource LeftTB}"/>
                            <TextBlock Text="*" Foreground="{ThemeResource rainspaceRedBrush}"/>
                        </StackPanel>
                        <TextBox x:Name="Cron" Style="{StaticResource MyTextBoxStyle}"
                                 Width="290" Text="{Binding Cron, Mode=OneWay}"
                                 FontSize="14" Margin="10,0,0,0"/>
                    </StackPanel>

                    <!-- Done time -->
                    <StackPanel Orientation="Horizontal" Grid.ColumnSpan="4" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="完成时间:" Style="{StaticResource LeftTB}"/>
                        </StackPanel>
                        <TextBlock x:Name="DoneTime" VerticalAlignment="Center"
                                   Margin="15,6,0,0" Text="{Binding DoneTime, Mode=OneWay}"
                                   Width="200" Foreground="{ThemeResource AppForegroundBrush}"/>
                    </StackPanel>

                    <!-- Save button -->
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0" HorizontalAlignment="Center">
                        <Button Content="保存" Style="{StaticResource AccentBtnStyle}"
                                Padding="32,10" Click="Save_Button_Click"/>
                    </StackPanel>
                </StackPanel>

                <!-- Close button -->
                <Button x:Name="CloseBtn" Canvas.ZIndex="2" Width="32" Height="32" MinWidth="44" MinHeight="44"
                        Click="Close_Button_Click" Style="{StaticResource ButtonIcon}"
                        Padding="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,8,8,0" AutomationProperties.Name="关闭待办详情"/>
                <StackPanel VerticalAlignment="Top" Margin="0,10,10,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
