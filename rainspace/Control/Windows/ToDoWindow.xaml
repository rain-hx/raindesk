<Window x:Class="rainspace.Control.Windows.ToDoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:rainspace"
        mc:Ignorable="d"
        Title="Task"
        >
    <!-- WinUI 3: WindowStyle/AllowsTransparency/Background=Transparent/ResizeMode/ShowInTaskbar/WindowStartupLocation removed -->

    <Grid Margin="40">
        <Border Background="{ThemeResource AppBackgroundBrush}" CornerRadius="12" Opacity="0.4" Margin="-4"/>

        <Border Style="{StaticResource BorderBG}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left sidebar navigation -->
                <Border Grid.Row="0" Grid.Column="0"
                        Background="{ThemeResource SubtleBrush}"
                        CornerRadius="8,0,0,8"
                        BorderBrush="{ThemeResource CardBorderBrush}"
                        BorderThickness="0,0,1,0">
                    <ListBox BorderThickness="0"
                             Background="Transparent"
                             Margin="8,12,8,12"
                             SelectedIndex="0"
                             SelectionChanged="MemuClick">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource rainspaceListBoxMenuStyle}"/>
                        </ListBox.ItemContainerStyle>

                        <ListBoxItem Content="待办列表" IsSelected="True" Tag="ExeList"/>
                        <ListBoxItem Content="历史待办" Tag="History"/>
                    </ListBox>
                </Border>

                <!-- Right content area -->
                <StackPanel x:Name="UFG" Grid.Column="1" Grid.Row="0">
                    <ContentControl>
                        <Border x:Name="RightCard" VerticalAlignment="Top"
                                PointerPressed="DragMove" Background="Transparent"
                                BorderThickness="0" Height="410"/>
                    </ContentControl>
                </StackPanel>

                <!-- Close button -->
                <Button Width="32" Height="32" MinWidth="44" MinHeight="44"
                        Click="Close_Button_Click"
                        Style="{StaticResource ButtonIcon}"
                        Padding="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,8,8,0"
                        Grid.Column="1"
                        AutomationProperties.Name="关闭待办窗口"/>

                <!-- New todo button -->
                <Button Content="新建待办"
                        Canvas.ZIndex="1"
                        Style="{StaticResource AccentBtnStyle}"
                        Grid.Column="1"
                        Margin="0,0,20,20"
                        Click="CreateBacklog_BtnClick"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Padding="20,10"/>
            </Grid>
        </Border>
    </Grid>
</Window>
