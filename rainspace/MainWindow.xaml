<Window x:Class="rainspace.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:uc="using:rainspace.Control.UserControls.PannelCard"
        xmlns:cfg="using:rainspace.Control.UserControls.Config"
        mc:Ignorable="d"
        Title="rainspace">

    <Grid x:Name="WindowRoot"
          x:FieldModifier="public"
          Background="{ThemeResource AppBackgroundBrush}"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">
        <Border x:Name="BGImageLayer"
                x:FieldModifier="public"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                IsHitTestVisible="False">
            <Grid>
                <Border x:Name="BGImageHost"
                        x:FieldModifier="public"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"/>
                <Border x:Name="BGDarkOverlay"
                        x:FieldModifier="public"
                        Background="#660E1726"
                        Opacity="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        IsHitTestVisible="False"/>
            </Grid>
        </Border>
        <Border x:Name="ContentGlassLayer"
                x:FieldModifier="public"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                IsHitTestVisible="False"/>
        <Border x:Name="BGBorder"
                x:FieldModifier="public"
                Background="Transparent"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
        <Border.Resources>
            <Style x:Key="RailButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="72"/>
                <Setter Property="Height" Value="96"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="4,4"/>
                <Setter Property="MinHeight" Value="44"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="22"/>
                <Setter Property="Foreground" Value="{ThemeResource SecondaryTextBrush}"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="UseSystemFocusVisuals" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource LauncherRailSelectedBrush}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource LauncherRailSelectedBrush}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Root"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0.45"
                                                                 Duration="0:0:0"/>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="FocusStates">
                                        <VisualState x:Name="Focused"/>
                                        <VisualState x:Name="Unfocused"/>
                                        <VisualState x:Name="PointerFocused"/>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border x:Name="Root"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="{TemplateBinding CornerRadius}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Border.Resources>

        <Grid HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <Grid x:Name="ContentShell"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="WindowStates">
                    <VisualState x:Name="ExtraWideState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="1440"/>
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="LeftColumn.Width" Value="200"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="WideState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="800"/>
                        </VisualState.StateTriggers>
                    </VisualState>
                    <VisualState x:Name="MediumState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="600"/>
                        </VisualState.StateTriggers>
                    </VisualState>
                    <VisualState x:Name="NarrowState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0"/>
                        </VisualState.StateTriggers>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="TopBarLayoutStates">
                    <VisualState x:Name="TopBarCompact">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0"/>
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="BrandTitle.Visibility" Value="Collapsed"/>
                            <Setter Target="SearchBoxHost.MinWidth" Value="0"/>
                            <Setter Target="SearchBoxHost.Width" Value="Auto"/>
                            <Setter Target="SearchBoxHost.MaxWidth" Value="420"/>
                            <Setter Target="TopBarInner.Padding" Value="16,0,18,0"/>
                            <Setter Target="SearchBoxHost.Margin" Value="10,0,10,0"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="TopBarDefault">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="760"/>
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="BrandTitle.Visibility" Value="Visible"/>
                            <Setter Target="SearchBoxHost.MinWidth" Value="0"/>
                            <Setter Target="SearchBoxHost.Width" Value="Auto"/>
                            <Setter Target="SearchBoxHost.MaxWidth" Value="700"/>
                            <Setter Target="TopBarInner.Padding" Value="24,0,28,0"/>
                            <Setter Target="SearchBoxHost.Margin" Value="18,0,18,0"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TopBarRow" Height="96"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="RailColumn" Width="0"/>
                <ColumnDefinition x:Name="LeftColumn" MinWidth="0" MaxWidth="148" Width="0"/>
                <ColumnDefinition x:Name="RightColumn" Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="TopBarHost"
                    x:FieldModifier="public"
                    Grid.Row="0" Grid.ColumnSpan="3"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0">
                <Grid x:Name="TopBarInner" Padding="24,0,28,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="18">
                        <Image x:Name="BrandLogo"
                               Source="ms-appx:///Assets/rainspaceLogo.png"
                               Width="44"
                               Height="44"
                               Stretch="Uniform"
                               AutomationProperties.Name="rainspace Logo"/>
                        <TextBlock x:Name="BrandTitle"
                                   Text="rainspace"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource AppForegroundBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Border x:Name="SearchBoxHost"
                            Grid.Column="1"
                            Margin="18,0,18,0"
                            MinWidth="0"
                            MaxWidth="700"
                            MinHeight="54"
                            Height="54"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Stretch"
                            Background="{ThemeResource LauncherSearchBackgroundBrush}"
                            BorderBrush="{ThemeResource LauncherShellBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="27"
                            Padding="22,0,20,0"
                            PointerEntered="SearchBoxHost_PointerEntered"
                            PointerExited="SearchBoxHost_PointerExited">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <TextBox x:Name="SearchBox" x:FieldModifier="public"
                                         Style="{StaticResource EmbeddedSearchTextBoxStyle}"
                                         Background="Transparent"
                                         CornerRadius="22"
                                         HorizontalAlignment="Stretch"
                                         VerticalAlignment="Center"
                                         PlaceholderText=""
                                         GotFocus="SearchBox_GotFocus"
                                         LostFocus="SearchBox_LostFocus"
                                         TextChanged="SearchBox_TextChanged"
                                         AutomationProperties.Name="搜索"
                                         ToolTipService.ToolTip="搜索应用、路径、待办、系统工具 (Ctrl+F)"
                                         TabIndex="4"
                                         IsTabStop="True"/>
                                <TextBlock x:Name="SearchPlaceholderText"
                                           Text="搜索应用..."
                                           IsHitTestVisible="False"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="17"
                                           Foreground="{ThemeResource SecondaryTextBrush}"/>
                                <TextBlock x:Name="SearchInputMirror"
                                           IsHitTestVisible="False"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource AppForegroundBrush}"
                                           Visibility="Collapsed"/>
                                <Border x:Name="SearchCaretBlinker"
                                        Width="1.5"
                                        Height="16"
                                        Background="{ThemeResource AppForegroundBrush}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False"
                                        Visibility="Collapsed"
                                        Canvas.ZIndex="4"/>
                            </Grid>
                            <FontIcon x:Name="SearchGlyphIcon"
                                      Grid.Column="1"
                                      Glyph="&#xE721;"
                                      FontFamily="{StaticResource FluentIconFont}"
                                      FontSize="24"
                                      Foreground="{ThemeResource SecondaryTextBrush}"
                                      VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Button x:Name="TopSettingsButton"
                             Grid.Column="2"
                             Width="52"
                             Height="52"
                            Padding="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                             Background="{ThemeResource LauncherSearchBackgroundBrush}"
                             BorderBrush="{ThemeResource LauncherShellBorderBrush}"
                             BorderThickness="1"
                             CornerRadius="26"
                             Click="SettingsRailClick"
                             AutomationProperties.Name="设置"
                             ToolTipService.ToolTip="设置"
                             TabIndex="5">
                        <FontIcon Glyph="&#xE713;"
                                  FontFamily="{StaticResource FluentIconFont}"
                                  FontSize="20"
                                  Foreground="{ThemeResource SecondaryTextBrush}"/>
                    </Button>

                    <Button x:Name="PageCloseButton"
                             Grid.Column="3"
                             Margin="10,0,0,0"
                             Width="52"
                             Height="52"
                             Padding="0"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Center"
                             Background="{ThemeResource LauncherSearchBackgroundBrush}"
                             BorderBrush="{ThemeResource LauncherShellBorderBrush}"
                             BorderThickness="1"
                             CornerRadius="26"
                             Click="CloseButtonClick"
                             AutomationProperties.Name="关闭"
                             ToolTipService.ToolTip="关闭窗口 (Alt+F4)"
                             TabIndex="6">
                        <FontIcon Glyph="&#xE711;"
                                  FontFamily="{StaticResource FluentIconFont}"
                                  FontSize="18"
                                  Foreground="{ThemeResource SecondaryTextBrush}"/>
                    </Button>

                </Grid>
            </Border>

            <uc:LeftCardControl x:Name="LeftCard"
                                x:FieldModifier="public"
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="2,8,2,8"
                                Visibility="Collapsed"/>

            <uc:RightCardControl x:Name="RightCard"
                                 x:FieldModifier="public"
                                 Grid.Row="1"
                                 Grid.Column="1"
                                 Grid.ColumnSpan="2"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Stretch"
                                 Margin="12,0,28,28"/>

            <Border x:Name="InlineConfigPanel"
                    x:FieldModifier="public"
                    Grid.Row="1"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Margin="8,4,18,10"
                    Background="Transparent"
                    Visibility="Collapsed">
                <cfg:ConfigPanel x:Name="ConfigPanel"
                                 x:FieldModifier="public"/>
            </Border>

            <Border x:Name="InlineTodoPanel"
                    x:FieldModifier="public"
                    Grid.Row="1"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Margin="8,6,18,14"
                    Background="Transparent"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Visibility="Collapsed">
                <ContentControl x:Name="TodoPanelHost"
                                x:FieldModifier="public"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"/>
            </Border>
            </Grid>

            <!-- 全局加载指示器 -->
            <Border x:Name="GlobalLoadingOverlay"
                    Background="{ThemeResource ShadowColor}"
                    Visibility="Collapsed"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="16">
                    <ProgressRing x:Name="GlobalLoadingRing"
                                  Width="48"
                                  Height="48"
                                  IsActive="True"
                                  Foreground="{ThemeResource rainspaceBlueBrush}"/>
                    <TextBlock x:Name="GlobalLoadingText"
                               Text="加载中..."
                               Foreground="White"
                               FontSize="16"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Toast 通知容器 -->
            <StackPanel x:Name="ToastContainer"
                        x:FieldModifier="public"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,20,20,0"
                        Spacing="8"/>

            <!-- 拖拽预览覆盖层 -->
            <Canvas x:Name="DragOverlayCanvas"
                    x:FieldModifier="internal"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    IsHitTestVisible="False"
                    Visibility="Collapsed"/>

            <Border x:Name="SearchResultsDropDown"
                    Visibility="Collapsed"
                    Opacity="0"
                    Background="{ThemeResource CardBackgroundBrush}"
                    BorderBrush="{ThemeResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="4,3"
                    MinWidth="280"
                    MaxWidth="520"
                    MaxHeight="260"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top">
                <Border.RenderTransform>
                    <TranslateTransform Y="-6"/>
                </Border.RenderTransform>
                <ContentControl x:Name="SearchResultsHost"/>
            </Border>
        </Grid>
        </Border>
    </Grid>
</Window>
