<UserControl x:Class="raindesk.Control.UserControls.PannelCard.LeftCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:cst="using:raindesk.Constant"
             xmlns:vm="using:raindesk.ViewModel"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="220">
    <UserControl.Resources>
        <Style x:Key="MenuStyle" TargetType="ListViewItem" BasedOn="{StaticResource raindeskSidebarItemStyle}">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="AllowDrop" Value="True"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                Padding="0">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource CardHoverBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Selected">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource MenuSelectedBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="SelectedUnfocused">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource MenuSelectedBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="PointerOverSelected">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource MenuSelectedBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Popup x:Name="MyPoptip" IsOpen="False">
            <Grid Background="Transparent">
                <Border Style="{StaticResource MyPoptipStyle}">
                    <TextBlock x:Name="MyPoptipContent"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               Text="Test"
                               FontSize="13"/>
                </Border>
            </Grid>
        </Popup>

        <Border x:Name="MyCard"
                Background="#82FBFDFF"
                BorderBrush="Transparent"
                BorderThickness="0"
                CornerRadius="14"
                PointerPressed="MyCard_PointerPressed"
                RightTapped="MyCard_RightTapped"
                AllowDrop="True"
                Drop="MyCard_Drop"
                DragEnter="MyCard_DragEnter"
                DragLeave="MyCard_DragLeave">
            <Border.ContextFlyout>
                <MenuFlyout x:Name="CardMenuFlyout">
                    <MenuFlyoutItem Text="新建菜单" Click="CreateMenu" Style="{StaticResource raindeskMenuFlyoutItemStyle}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE710;"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="新建关联菜单" Click="CreateLinkMenu" Style="{StaticResource raindeskMenuFlyoutItemStyle}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE71B;"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem x:Name="AlterPW1" Text="修改密码" Click="AlterPassword" Style="{StaticResource raindeskMenuFlyoutItemStyle}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE72E;"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </Border.ContextFlyout>

            <Grid Padding="3,2,3,2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border x:Name="MenuDivider"
                        Grid.Row="0"
                        Height="1"
                        Background="{ThemeResource DividerLightBrush}"
                        Margin="8,0,8,2"
                        Opacity="0.35"/>

                <ListView x:Name="MenuListBox"
                          x:FieldModifier="public"
                          Grid.Row="1"
                          Padding="0"
                          ScrollViewer.VerticalScrollBarVisibility="Hidden"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ItemsSource="{Binding MenuList}"
                          Tag="{Binding AppConfig.MenuCardWidth}"
                          BorderThickness="0"
                          Background="Transparent"
                          SelectedIndex="{Binding AppConfig.SelectedMenuIndex}"
                          SelectionChanged="Menu_SelectionChanged"
                          ContainerContentChanging="MenuListBox_ContainerContentChanging"
                          RightTapped="MyCard_RightTapped">
                    <ListView.Resources>
                        <MenuFlyout x:Name="MenuDialog">
                            <MenuFlyoutItem Text="新建菜单" Click="CreateMenu" Style="{StaticResource raindeskMenuFlyoutItemStyle}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE710;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="新建关联菜单" Click="CreateLinkMenu" Style="{StaticResource raindeskMenuFlyoutItemStyle}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE71B;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem Text="重命名" Click="RenameMenu" Tag="{Binding}" Style="{StaticResource raindeskMenuFlyoutItemStyle}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE70F;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="加密此列表" Click="EncryptMenu" Tag="{Binding}" Style="{StaticResource raindeskMenuFlyoutItemStyle}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE72E;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="AlterPW2" Text="修改密码" Click="AlterPassword" Style="{StaticResource raindeskMenuFlyoutItemStyle}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE785;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem Text="修改图标" Click="EditMenuGeometry" Tag="{Binding}" Style="{StaticResource raindeskMenuFlyoutItemStyle}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE790;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem Text="删除" Click="DeleteMenu" Tag="{Binding}" Style="{StaticResource raindeskDangerMenuItemStyle}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE74D;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </ListView.Resources>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource MenuStyle}">
                            <Setter Property="ContextFlyout" Value="{StaticResource MenuDialog}"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:MenuInfo">
                            <Grid Tag="{x:Bind}"
                                  MinHeight="34"
                                  Width="108"
                                  HorizontalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="34"/>
                                    <RowDefinition Height="1"/>
                                </Grid.RowDefinitions>
                                <Border Background="{ThemeResource MenuHoverBrush}"
                                        CornerRadius="8"
                                        Visibility="{x:Bind IsSelected_NoWrite, Converter={StaticResource MyBoolean2VisibilityConverter}}"/>
                                <TextBox Style="{StaticResource MyTextBoxStyle}"
                                         Text="{x:Bind MenuName, Mode=TwoWay}"
                                         Width="92"
                                         Height="26"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center"
                                         LostFocus="LostFocusOrEnterDown"
                                         KeyDown="LostFocusOrEnterDown"
                                         Tag="{x:Bind}"
                                         BorderThickness="0"
                                         Visibility="{x:Bind MenuEdit}"/>
                                <Grid Visibility="{x:Bind NotMenuEdit}" ColumnSpacing="7" Padding="10,0,8,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="17"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                    </Grid.ColumnDefinitions>
                                    <Viewbox Width="15"
                                             Height="15"
                                             VerticalAlignment="Center"
                                             HorizontalAlignment="Center">
                                        <Path x:Name="MenuIconPath"
                                              Fill="{x:Bind GeometryColor, Converter={StaticResource TextToColorConverter}}"
                                              Stretch="Uniform"/>
                                    </Viewbox>
                                    <Grid Grid.Column="1">
                                        <TextBlock Text="{x:Bind MenuName}"
                                                   Foreground="{ThemeResource AppForegroundBrush}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextAlignment="Center"
                                                   LineHeight="20"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                    <Ellipse Grid.Column="2"
                                             Width="6"
                                             Height="6"
                                             Fill="{ThemeResource raindeskBlueBrush}"
                                             VerticalAlignment="Center"
                                             Visibility="{x:Bind IsSelected_NoWrite, Converter={StaticResource MyBoolean2VisibilityConverter}}"/>
                                </Grid>
                                <Border x:Name="MenuItemDivider"
                                        Grid.Row="1"
                                        Height="1"
                                        Background="{ThemeResource DividerLightBrush}"
                                        Margin="10,0,10,0"
                                        Opacity="0.35"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</UserControl>
