<UserControl x:Class="raindesk.Control.UserControls.PannelCard.RightCardControl"
             x:Name="RootControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:cst="using:raindesk.Constant"
             xmlns:launcher="using:raindesk.Features.Launcher.Presentation.WinUI"
             xmlns:ot="using:raindesk.Control.Other"
             xmlns:si="using:raindesk.Control.UserControls.SystemItem"
             xmlns:vm="using:raindesk.ViewModel"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             AllowDrop="True">
    <UserControl.Resources>
        <ItemsPanelTemplate x:Key="AllGroupsShortcutPanelTemplate">
            <ItemsWrapGrid Orientation="Horizontal"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Top"/>
        </ItemsPanelTemplate>
        <Style x:Key="ImageStyle" TargetType="Image">
            <Setter Property="Stretch" Value="Uniform"/>
        </Style>
        <Style x:Key="ImageStyleNoWrite" TargetType="Image">
            <Setter Property="Stretch" Value="Uniform"/>
        </Style>
        <Style x:Key="MyListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="UseSystemFocusVisuals" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Root"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver"/>
                                <!-- Selection chrome lives in the item template via IsListSelected_NoWrite. -->
                                <VisualState x:Name="Selected"/>
                                <VisualState x:Name="SelectedUnfocused"/>
                                <VisualState x:Name="PointerOverSelected"/>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GroupTabInlineEditStyle" TargetType="TextBox">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="MaxHeight" Value="28"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{ThemeResource AppForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource AccentLightBrush}"/>
            <Setter Property="SelectionHighlightColor" Value="{ThemeResource raindeskBlueBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="UseSystemFocusVisuals" Value="False"/>
        </Style>
        <Style x:Key="GroupListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="MaxHeight" Value="44"/>
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="UseSystemFocusVisuals" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="GroupItemRoot"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                CornerRadius="8"
                                Padding="8,4"
                                MinHeight="40"
                                MaxHeight="44">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ItemsPanelTemplate x:Key="GroupTabRowPanel">
            <ItemsStackPanel Orientation="Vertical"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Top"/>
        </ItemsPanelTemplate>
        <DataTemplate x:Key="GroupTabItemDataTemplate" x:DataType="vm:MenuInfo">
            <Grid Height="44"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Center">
                <Border Background="{ThemeResource AccentLightBrush}"
                        CornerRadius="8"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Opacity="{x:Bind SelectionIndicatorOpacity_NoWrite, Mode=OneWay}"
                        IsHitTestVisible="False"/>
                <Grid x:Name="GroupTabContentHost"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      MinHeight="36"
                      Margin="6,0">
                    <Grid Visibility="{x:Bind NotMenuEdit, Mode=OneWay}"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Viewbox Grid.Column="0"
                                 Width="16"
                                 Height="16"
                                 VerticalAlignment="Center"
                                 HorizontalAlignment="Center">
                            <Path x:Name="GroupTabIconPath"
                                  Fill="{x:Bind GeometryColor, Converter={StaticResource TextToColorConverter}, Mode=OneWay}"
                                  Stretch="Uniform"/>
                        </Viewbox>
                        <TextBlock x:Name="GroupTabLabel"
                                   Grid.Column="1"
                                   Text="{x:Bind MenuName, Mode=OneWay, Converter={StaticResource StringPreviewConverter}, ConverterParameter=5}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   LineHeight="19"
                                   LineStackingStrategy="BlockLineHeight"
                                   Foreground="{x:Bind GroupTabLabelBrush_NoWrite, Mode=OneWay}"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   MaxWidth="76"
                                   TextWrapping="NoWrap"/>
                        <Button x:Name="InlineGroupBarToggleButton"
                                Grid.Column="2"
                                Width="32"
                                Height="32"
                                MinWidth="32"
                                MinHeight="32"
                                Margin="6,0,0,0"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="7"
                                Visibility="Collapsed"
                                Click="ToggleGroupBarClick"
                                AutomationProperties.Name="收起分组名称"
                                ToolTipService.ToolTip="收起分组名称">
                            <FontIcon x:Name="InlineGroupBarToggleIcon"
                                      Glyph="&#xE76B;"
                                      FontFamily="{StaticResource FluentIconFont}"
                                      FontSize="15"
                                      Foreground="{ThemeResource AppForegroundBrush}"/>
                        </Button>
                    </Grid>
                    <Grid Width="88"
                          Height="36"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Visibility="{x:Bind MenuEdit, Mode=OneWay}">
                        <TextBox Style="{StaticResource GroupTabInlineEditStyle}"
                                 Width="88"
                                 Height="36"
                                 Opacity="0"
                                 Canvas.ZIndex="0"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Stretch"
                                 Tag="{x:Bind}"
                                 LostFocus="GroupEditLostFocusOrEnterDown"
                                 KeyDown="GroupEditKeyDown"/>
                        <TextBlock x:Name="InlineEditMirror"
                                   Text="{x:Bind MenuName, Mode=OneWay, Converter={StaticResource StringPreviewConverter}, ConverterParameter=5}"
                                   IsHitTestVisible="False"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Width="76"
                                   MaxLines="1"
                                   TextWrapping="NoWrap"
                                   Foreground="{ThemeResource AppForegroundBrush}"
                                   Visibility="{x:Bind MenuEdit, Mode=OneWay}"
                                   Canvas.ZIndex="1"/>
                        <Border x:Name="InlineEditCaretBlinker"
                                Width="1.5"
                                Height="14"
                                Background="{ThemeResource AppForegroundBrush}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                Visibility="Collapsed"
                                Canvas.ZIndex="3"/>
                    </Grid>
                </Grid>
                <Border Height="3"
                        VerticalAlignment="Top"
                        Margin="0,4,0,0"
                        Background="{ThemeResource raindeskBlueBrush}"
                        HorizontalAlignment="Stretch"
                        IsHitTestVisible="False"
                        Opacity="{x:Bind DragDropArrowOpacity_NoWrite, Mode=OneWay}"
                        Visibility="{x:Bind DragDropArrowVisibility_NoWrite, Mode=OneWay}"/>
                <Border Height="4"
                        CornerRadius="2"
                        Background="{ThemeResource raindeskBlueBrush}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Bottom"
                        Opacity="0"
                        IsHitTestVisible="False"/>
            </Grid>
        </DataTemplate>
        <Style x:Key="GroupListViewItemContainerRowStyle" TargetType="ListViewItem" BasedOn="{StaticResource GroupListViewItemStyle}">
            <Setter Property="ContextFlyout" Value="{StaticResource GroupContextMenu}"/>
        </Style>
        <Style x:Key="CompactGroupMenuItemStyle" TargetType="MenuFlyoutItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Foreground" Value="{ThemeResource AppForegroundBrush}"/>
        </Style>
        <Style x:Key="CompactGroupDangerMenuItemStyle" TargetType="MenuFlyoutItem" BasedOn="{StaticResource CompactGroupMenuItemStyle}">
            <Setter Property="Foreground" Value="{ThemeResource raindeskRedBrush}"/>
        </Style>

        <MenuFlyout x:Name="GroupContextMenu" x:Key="GroupContextMenu">
            <MenuFlyoutItem x:Name="EditGroupIconMenuItem"
                            Text="修改图标"
                            Click="EditGroupGeometryClick"
                            Tag="{Binding}"
                            Style="{StaticResource CompactGroupMenuItemStyle}">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE790;" FontSize="14"/>
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator x:Name="EditGroupIconMenuSeparator"/>
            <MenuFlyoutItem Text="删除分组"
                            x:Name="DeleteGroupMenuItem"
                            Click="DeleteGroupClick"
                            Tag="{Binding}"
                            Style="{StaticResource CompactGroupDangerMenuItemStyle}">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="重命名"
                            Click="RenameGroupClick"
                            Tag="{Binding}"
                            Style="{StaticResource CompactGroupMenuItemStyle}">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE70F;" FontSize="14"/>
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>

        <MenuFlyout x:Key="IconDialog" x:Name="IconDialog">
            <MenuFlyoutItem x:Name="OpenFolderContextMenuItem" Text="打开文件夹" Click="OpenFolderFromContext" Tag="{Binding}" Style="{StaticResource raindeskMenuFlyoutItemStyle}" Visibility="Collapsed">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8B7;"/>
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSubItem x:Name="FolderSizeContextMenuItem" Text="文件夹大小" Style="{StaticResource raindeskMenuFlyoutSubItemStyle}" Visibility="Collapsed">
                <MenuFlyoutSubItem.Icon>
                    <FontIcon Glyph="&#xE8A9;"/>
                </MenuFlyoutSubItem.Icon>
                <MenuFlyoutItem Text="小" Click="SetFolderSmall" Tag="{Binding}" Style="{StaticResource raindeskMenuFlyoutItemStyle}"/>
                <MenuFlyoutItem Text="中" Click="SetFolderMedium" Tag="{Binding}" Style="{StaticResource raindeskMenuFlyoutItemStyle}"/>
                <MenuFlyoutItem Text="大" Click="SetFolderLarge" Tag="{Binding}" Style="{StaticResource raindeskMenuFlyoutItemStyle}"/>
            </MenuFlyoutSubItem>
            <MenuFlyoutSeparator x:Name="PrimaryContextMenuSeparator"/>
            <MenuFlyoutItem x:Name="AdminStartContextMenuItem" Text="管理员方式运行" Click="IconAdminStart" Tag="{Binding}" Style="{StaticResource raindeskMenuFlyoutItemStyle}">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE83D;"/>
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem x:Name="ShowInExplorerContextMenuItem" Text="打开文件所在位置" Click="ShowInExplore" Tag="{Binding}" Style="{StaticResource raindeskMenuFlyoutItemStyle}">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8B7;"/>
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem x:Name="PropertiesContextMenuItem" Text="属性" Click="PropertyConfig" Tag="{Binding}" Style="{StaticResource raindeskMenuFlyoutItemStyle}">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE946;"/>
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator x:Name="EditContextMenuSeparator"/>
            <MenuFlyoutItem x:Name="RenameContextMenuItem" Text="重命名" Click="RenameIcon" Tag="{Binding}" Style="{StaticResource raindeskMenuFlyoutItemStyle}">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE70F;"/>
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem x:Name="RemoveContextMenuItem" Text="从列表移除" Click="RemoveIcon" Tag="{Binding}" Style="{StaticResource raindeskDangerMenuItemStyle}">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE74D;"/>
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>

        <cst:RunTimeStatus x:Key="RunTimeStatus"/>
        <cst:DictConst x:Key="DictConst"/>
    </UserControl.Resources>

    <Grid x:Name="RootGrid"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">
        <Border AllowDrop="True"
                x:Name="WrapCard"
                Visibility="Visible"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                DragOver="WrapCard_DragOver"
                Drop="Wrap_Drop"
                Background="{ThemeResource LauncherShellBackgroundBrush}"
                BorderBrush="Transparent"
                BorderThickness="0"
                CornerRadius="28"
                RightTapped="WrapCard_RightTapped"
                PointerWheelChanged="IconListView_PointerWheelChanged">
            <Border.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="添加URL项目" Click="AddUrlIcon" Style="{StaticResource raindeskMenuFlyoutItemStyle}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE71B;"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="添加系统项目" Click="AddSystemIcon" Style="{StaticResource raindeskMenuFlyoutItemStyle}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8B7;"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSubItem Text="界面设置" Style="{StaticResource raindeskMenuFlyoutSubItemStyle}">
                        <MenuFlyoutSubItem.Icon>
                            <FontIcon Glyph="&#xE713;"/>
                        </MenuFlyoutSubItem.Icon>
                        <MenuFlyoutItem x:Name="TopBarVisibilityMenuItem"
                                         Text="展开顶部栏"
                                         Click="ToggleTopBarFromIconMenu"
                                         Style="{StaticResource raindeskMenuFlyoutItemStyle}"/>
                        <MenuFlyoutItem x:Name="GroupBarVisibilityMenuItem"
                                         Text="展开分组栏"
                                         Click="ToggleGroupBarFromIconMenu"
                                         Style="{StaticResource raindeskMenuFlyoutItemStyle}"/>
                    </MenuFlyoutSubItem>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem x:Name="CardLockCM" Text="锁定主面板" Click="LockAppPanel" Style="{StaticResource raindeskMenuFlyoutItemStyle}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE72E;"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Name="showTitle" Text="隐藏/显示标题" Click="ShowTitle_Click" Style="{StaticResource raindeskMenuFlyoutItemStyle}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8A7;"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="批量操作" Click="BatchHandle" Tag="{Binding}" Style="{StaticResource raindeskMenuFlyoutItemStyle}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8FD;"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </Border.ContextFlyout>

            <Grid Padding="30,12,8,8">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="TitleRow" Height="0"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="GroupColumn" Width="Auto"/>
                    <ColumnDefinition x:Name="ContentColumn" Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid x:Name="TitleBar"
                      ColumnSpacing="12"
                      Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SectionTitle"
                               Text="我的快捷"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource AppForegroundBrush}"
                               VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Button x:Name="BackInlineButton"
                                Style="{StaticResource raindeskCommandButtonStyle}"
                                Click="BackInlinePanel"
                                MinHeight="44"
                                Visibility="Collapsed"
                                AutomationProperties.Name="返回">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="&#xE72B;" FontSize="14"/>
                                <TextBlock Text="返回" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid x:Name="GroupBarHost"
                      Grid.Row="1"
                      Grid.Column="0"
                      Margin="-22,0,10,0"
                      Background="Transparent"
                      VerticalAlignment="Stretch">
                <Border Width="1"
                        Margin="0,-12,2,-26"
                        HorizontalAlignment="Right"
                        Background="Transparent"
                        IsHitTestVisible="False"/>
                <Grid x:Name="GroupBar"
                      AllowDrop="True"
                      DragOver="GroupBar_IconDragOver"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      RowSpacing="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer x:Name="GroupScrollViewer"
                                  Grid.Row="0"
                                  AllowDrop="True"
                                  DragOver="GroupBar_IconDragOver"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  VerticalContentAlignment="Top"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollMode="Disabled"
                                  VerticalScrollMode="Enabled"
                                  ZoomMode="Disabled"
                                  PointerWheelChanged="GroupScrollViewer_PointerWheelChanged">
                        <Grid MinWidth="0"
                              VerticalAlignment="Top"
                              HorizontalAlignment="Stretch">
                            <ListView x:Name="GroupListView"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Padding="0"
                                      MinWidth="0"
                                      MinHeight="0"
                                      Height="Auto"
                                      VerticalAlignment="Stretch"
                                      HorizontalAlignment="Stretch"
                                      ShowsScrollingPlaceholders="False"
                                      CanDragItems="False"
                                      CanReorderItems="False"
                                      AllowDrop="True"
                                      ReorderMode="Disabled"
                                      IsItemClickEnabled="True"
                                      SelectionMode="None"
                                      ItemClick="GroupListView_ItemClick"
                                      DragOver="GroupListView_IconDragOver"
                                      DragLeave="GroupListView_IconDragLeave"
                                      Drop="GroupListView_IconDrop"
                                      ContainerContentChanging="GroupListView_ContainerContentChanging"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                      ScrollViewer.HorizontalScrollMode="Disabled"
                                      ScrollViewer.VerticalScrollMode="Disabled"
                                      PointerWheelChanged="GroupScrollViewer_PointerWheelChanged">
                                <ListView.Resources>
                                    <Style TargetType="ScrollViewer">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="HorizontalScrollMode" Value="Disabled"/>
                                        <Setter Property="VerticalScrollMode" Value="Disabled"/>
                                        <Setter Property="ZoomMode" Value="Disabled"/>
                                    </Style>
                                </ListView.Resources>
                                <ListView.ItemsPanel>
                                    <StaticResource ResourceKey="GroupTabRowPanel"/>
                                </ListView.ItemsPanel>
                                <ListView.ItemTemplate>
                                    <StaticResource ResourceKey="GroupTabItemDataTemplate"/>
                                </ListView.ItemTemplate>
                                <ListView.ItemContainerStyle>
                                    <StaticResource ResourceKey="GroupListViewItemContainerRowStyle"/>
                                </ListView.ItemContainerStyle>
                            </ListView>
                            <Canvas IsHitTestVisible="False"
                                    VerticalAlignment="Stretch"
                                    HorizontalAlignment="Left"
                                    Width="4"
                                    Background="{x:Null}">
                                <Grid x:Name="GroupTabSelectionIndicator"
                                      Width="4"
                                      Canvas.Left="0"
                                      Visibility="Collapsed"
                                      IsHitTestVisible="False">
                                    <Border x:Name="GroupTabSelectionIndicatorMark"
                                            Width="4"
                                            Height="36"
                                            CornerRadius="2"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource raindeskBlueBrush}"/>
                                </Grid>
                            </Canvas>
                        </Grid>
                    </ScrollViewer>
                    <Button x:Name="CreateGroupButton"
                                Grid.Row="1"
                                Width="48"
                                Height="40"
                                MinWidth="48"
                                MinHeight="40"
                                Padding="0"
                                HorizontalAlignment="Left"
                                Margin="0"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="10"
                                Click="CreateGroupClick"
                                AutomationProperties.Name="新建分组"
                                ToolTipService.ToolTip="创建新的快捷方式分组">
                            <FontIcon Glyph="&#xE710;"
                                      FontFamily="{StaticResource FluentIconFont}"
                                      FontSize="16"
                                      Foreground="{ThemeResource raindeskBlueBrush}"/>
                    </Button>
                </Grid>
                </Grid>

                <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,0">
                    <ot:PasswordDialog x:Name="PDDialog"
                                       x:FieldModifier="public"
                                       x:Load="False"
                                       Canvas.ZIndex="99"
                                       Margin="0,-100,0,0"/>
                    <Grid x:Name="WrapUFG"
                          x:FieldModifier="public"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Padding="0,0"
                          SizeChanged="ShortcutHost_SizeChanged"
                          PointerPressed="WrapUFG_PointerPressed"
                          PointerMoved="WrapUFG_PointerMoved"
                          PointerReleased="WrapUFG_PointerReleased"
                          PointerCanceled="WrapUFG_PointerCanceled">
                        <ListView x:Name="IconListView"
                                  x:FieldModifier="public"
                                  ItemsSource="{x:Bind ShortcutTiles_NoWrite, Mode=OneWay}"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  Padding="0"
                                  Margin="0"
                                  HorizontalContentAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  HorizontalAlignment="Stretch"
                                  ShowsScrollingPlaceholders="False"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  CanDragItems="True"
                                  CanReorderItems="False"
                                  AllowDrop="True"
                                  ReorderMode="Disabled"
                                  SizeChanged="IconListView_SizeChanged"
                                  DragItemsStarting="IconListView_DragItemsStarting"
                                  DragItemsCompleted="IconListView_DragItemsCompleted"
                                  DragOver="IconListView_DragOver"
                                  Drop="IconListView_Drop"
                                  ContainerContentChanging="IconListView_ContainerContentChanging"
                                  IsItemClickEnabled="False"
                                  SelectionMode="Extended">
                            <ListView.ItemContainerTransitions>
                                <TransitionCollection>
                                    <RepositionThemeTransition/>
                                    <AddDeleteThemeTransition/>
                                </TransitionCollection>
                            </ListView.ItemContainerTransitions>
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <launcher:LauncherGridPanel HorizontalAlignment="Stretch"
                                                                VerticalAlignment="Top"
                                                                UseManualPositions="{Binding UseManualShortcutGridPositions_NoWrite, ElementName=RootControl, Mode=OneWay}"
                                                                ColumnCount="{Binding ShortcutColumnCount_NoWrite, ElementName=RootControl, Mode=OneWay}"
                                                                ItemWidth="{Binding ShortcutItemSlotWidth_NoWrite, ElementName=RootControl, Mode=OneWay}"
                                                                ItemHeight="{Binding ShortcutItemSlotHeight_NoWrite, ElementName=RootControl, Mode=OneWay}"/>
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource MyListViewItemStyle}"/>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:IconInfo">
                                    <Grid x:Name="ShortcutTemplateRoot"
                                          Tag="{x:Bind}"
                                          ContextFlyout="{StaticResource IconDialog}"
                                          Width="{Binding ShortcutItemSlotWidth_NoWrite, ElementName=RootControl, Mode=OneWay}"
                                          Height="{Binding ShortcutItemSlotHeight_NoWrite, ElementName=RootControl, Mode=OneWay}"
                                          Background="Transparent"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          PointerEntered="MenuIcon_PointerEntered"
                                          PointerExited="MenuIcon_PointerExited"
                                          PointerPressed="Icon_PointerPressed"
                                          Tapped="Icon_Tapped"
                                          DoubleTapped="Icon_DoubleTapped"
                                          IsDoubleTapEnabled="True"
                                          AutomationProperties.Name="{x:Bind Name}">
                                        <Grid Visibility="{x:Bind IsLaunchableShortcut_NoWrite, Converter={StaticResource MyBoolean2VisibilityConverter}, Mode=OneWay}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center">
                                            <StackPanel HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Spacing="8">
                                                <Grid x:Name="ShortcutIconHost"
                                                      Width="64"
                                                      Height="64"
                                                      MinHeight="64"
                                                      HorizontalAlignment="Center">
                                                    <Border x:Name="ShortcutIconSurface"
                                                            Width="64"
                                                            Height="64"
                                                            CornerRadius="18"
                                                            Background="Transparent"
                                                            BorderBrush="{ThemeResource LauncherMutedBorderBrush}"
                                                            BorderThickness="0"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
                                                    <Border x:Name="ShortcutIconFrame"
                                                            Width="48"
                                                            Height="48"
                                                            CornerRadius="14"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Padding="0"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                        <Image Source="{x:Bind BitmapImageCached_NoWrite, Mode=OneWay}"
                                                               Stretch="Uniform"
                                                               Width="48"
                                                               Height="48"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                    </Border>
                                                    <Border Width="48"
                                                            Height="48"
                                                            CornerRadius="14"
                                                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                                            BorderThickness="2"
                                                            Background="Transparent"
                                                            Visibility="{x:Bind IsListSelected_NoWrite, Converter={StaticResource MyBoolean2VisibilityConverter}, Mode=OneWay}"
                                                            IsHitTestVisible="False"/>
                                                    <Border Width="20"
                                                            Height="20"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Top"
                                                            Margin="0,-2,-2,0"
                                                            CornerRadius="10"
                                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                            Visibility="{x:Bind IsListSelected_NoWrite, Converter={StaticResource MyBoolean2VisibilityConverter}, Mode=OneWay}"
                                                            IsHitTestVisible="False">
                                                        <FontIcon Glyph="&#xE73E;"
                                                                  FontSize="11"
                                                                  Foreground="White"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                                    </Border>
                                                </Grid>
                                                <TextBlock Width="{Binding ShortcutItemSlotWidth_NoWrite, ElementName=RootControl, Mode=OneWay}"
                                                           Height="22"
                                                           MaxLines="1"
                                                           FontSize="13"
                                                           FontWeight="Normal"
                                                           TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center"
                                                           Padding="4,0"
                                                           Foreground="{Binding DataContext.AppConfig.TextColor, ElementName=RootGrid, Converter={StaticResource TextToColorConverter}}"
                                                           Visibility="{Binding AppConfig.ShowShortcutTitle, ElementName=RootControl, Converter={StaticResource MyBoolean2VisibilityConverter}, Mode=OneWay}"
                                                           Text="{x:Bind Name, Mode=OneWay}"/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Visibility="{x:Bind IsDragYieldPlaceholder_NoWrite, Converter={StaticResource MyBoolean2VisibilityConverter}, Mode=OneWay}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False">
                                            <StackPanel HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Spacing="4">
                                                <Grid Width="52"
                                                      Height="52"
                                                      MinHeight="52"
                                                      HorizontalAlignment="Center">
                                                    <Rectangle Width="46"
                                                               Height="46"
                                                               RadiusX="14"
                                                               RadiusY="14"
                                                               Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                                                               StrokeThickness="1.4"
                                                               StrokeDashArray="4,3"
                                                               StrokeDashCap="Round"
                                                               Fill="Transparent"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Opacity="0.85"/>
                                                    <Border MinWidth="18"
                                                            Height="18"
                                                            Padding="4,0"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Top"
                                                            Margin="0,-4,-4,0"
                                                            CornerRadius="9"
                                                            Background="{ThemeResource AccentFillColorDefaultBrush}">
                                                        <TextBlock Text="{x:Bind BatchDragGroupCount_NoWrite, Mode=OneWay}"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="White"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Visibility="{x:Bind IsFolder, Converter={StaticResource MyBoolean2VisibilityConverter}, Mode=OneWay}"
                                              Width="104"
                                              Height="104"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              AutomationProperties.Name="{x:Bind Name, Mode=OneWay}"
                                              AutomationProperties.HelpText="{x:Bind Content, Mode=OneWay}">
                                            <Grid Width="104"
                                                  Height="104"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center">
                                                <Grid x:Name="FolderVisualRoot"
                                                      Width="48"
                                                      Height="48"
                                                      Margin="0,13,0,0"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Top"
                                                      ToolTipService.ToolTip="{x:Bind Content, Mode=OneWay}">
                                                    <Border x:Name="FolderVisualSurface"
                                                            Background="{ThemeResource LauncherFolderTileBrush}"
                                                            BorderThickness="0"
                                                            CornerRadius="12"/>
                                                    <Grid x:Name="FolderPreviewItems"
                                                          Width="36"
                                                          Height="16"
                                                          Margin="0"
                                                          ColumnSpacing="4"
                                                          RowSpacing="4"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          IsHitTestVisible="False">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="0"/>
                                                            <RowDefinition Height="0"/>
                                                        </Grid.RowDefinitions>
                                                        <Border x:Name="FolderPreviewCell1" Grid.Row="0" Grid.Column="0" Width="16" Height="16" Padding="1" CornerRadius="4" Background="{ThemeResource LauncherFolderPreviewCellBrush}"><Image x:Name="FolderPreviewImage1" Source="{x:Bind FolderPreviewImage1_NoWrite, Mode=OneWay}" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/></Border>
                                                        <Border x:Name="FolderPreviewCell2" Grid.Row="0" Grid.Column="1" Width="16" Height="16" Padding="1" CornerRadius="4" Background="{ThemeResource LauncherFolderPreviewCellBrush}"><Image x:Name="FolderPreviewImage2" Source="{x:Bind FolderPreviewImage2_NoWrite, Mode=OneWay}" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/></Border>
                                                        <Border x:Name="FolderPreviewCell3" Visibility="Collapsed" Grid.Row="1" Grid.Column="0" Width="16" Height="16" Padding="1" CornerRadius="4" Background="{ThemeResource LauncherFolderPreviewCellBrush}"><Image x:Name="FolderPreviewImage3" Source="{x:Bind FolderPreviewImage3_NoWrite, Mode=OneWay}" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/></Border>
                                                        <Border x:Name="FolderPreviewCell4" Visibility="Collapsed" Grid.Row="1" Grid.Column="1" Width="16" Height="16" Padding="1" CornerRadius="4" Background="{ThemeResource LauncherFolderPreviewCellBrush}"><Image x:Name="FolderPreviewImage4" Source="{x:Bind FolderPreviewImage4_NoWrite, Mode=OneWay}" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/></Border>
                                                        <Border x:Name="FolderPreviewCell5" Visibility="Collapsed" Grid.Row="2" Grid.Column="0" Width="16" Height="16" Padding="1" CornerRadius="4" Background="{ThemeResource LauncherFolderPreviewCellBrush}"><Image x:Name="FolderPreviewImage5" Source="{x:Bind FolderPreviewImage5_NoWrite, Mode=OneWay}" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/></Border>
                                                        <Border x:Name="FolderPreviewCell6" Visibility="Collapsed" Grid.Row="2" Grid.Column="1" Width="16" Height="16" Padding="1" CornerRadius="4" Background="{ThemeResource LauncherFolderPreviewCellBrush}"><Image x:Name="FolderPreviewImage6" Source="{x:Bind FolderPreviewImage6_NoWrite, Mode=OneWay}" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/></Border>
                                                    </Grid>
                                                    <Border MinWidth="22"
                                                            Height="22"
                                                            Padding="5,0"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Top"
                                                            Margin="0,-4,-4,0"
                                                            CornerRadius="11"
                                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                            Visibility="{x:Bind HasFolderPreviewOverflow_NoWrite, Converter={StaticResource MyBoolean2VisibilityConverter}, Mode=OneWay}"
                                                            IsHitTestVisible="False">
                                                        <TextBlock Text="{x:Bind FolderPreviewOverflowCount_NoWrite, Mode=OneWay}"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="White"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                </Grid>
                                                <TextBlock Width="104"
                                                           Height="22"
                                                           MaxLines="1"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextAlignment="Center"
                                                           VerticalAlignment="Bottom"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,0,0,5"
                                                           Padding="4,0"
                                                           Foreground="{ThemeResource AppForegroundBrush}"
                                                           Visibility="Visible"
                                                           Canvas.ZIndex="20"
                                                           Text="{x:Bind Name_NoWrite, Mode=OneWay}"/>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Canvas x:Name="IconMarqueeCanvas"
                                IsHitTestVisible="False"
                                Visibility="Collapsed"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">
                            <Rectangle x:Name="IconMarqueeRect"
                                       Visibility="Collapsed"
                                       Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                                       StrokeThickness="1"
                                       Fill="#330078D4"
                                       RadiusX="4"
                                       RadiusY="4"/>
                        </Canvas>
                    </Grid>

                    <Grid x:Name="InlineUrlPanel"
                          x:Load="False"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch">
                        <ContentControl x:Name="InlineUrlHost"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Top"/>
                    </Grid>

                    <Grid x:Name="InlineSystemPanel"
                          x:Load="False"
                          RowSpacing="18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Padding="12"
                                Background="{ThemeResource ControlFillBrush}"
                                BorderBrush="{ThemeResource ControlBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TabView x:Name="InlineSystemTabs"
                                     SelectionChanged="InlineSystemTabs_SelectionChanged"
                                     IsAddTabButtonVisible="False"
                                     CanDragTabs="False"
                                     Background="Transparent">
                                <TabView.Resources>
                                    <Style TargetType="TabViewItem">
                                        <Setter Property="FontSize" Value="16"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </TabView.Resources>
                                <TabViewItem Tag="System" Header="系统应用" IsClosable="False"/>
                                <TabViewItem Tag="StartMenu" Header="开始菜单应用" IsClosable="False"/>
                            </TabView>
                            <Border Grid.Column="1"
                                    BorderBrush="{ThemeResource ControlBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Background="{ThemeResource AppBackgroundBrush}"
                                    Padding="12,0"
                                    MinWidth="240"
                                    MaxWidth="360"
                                    Height="44"
                                    VerticalAlignment="Center">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE721;"
                                              FontFamily="{StaticResource FluentIconFont}"
                                              FontSize="16"
                                              Foreground="{ThemeResource SecondaryTextBrush}"
                                              VerticalAlignment="Center"/>
                                    <Grid Grid.Column="1">
                                        <TextBox x:Name="InlineSystemSearchBox"
                                                 Style="{StaticResource EmbeddedSearchTextBoxStyle}"
                                                 PlaceholderText=""
                                                 TextChanged="InlineSystemSearchBox_TextChanged"
                                                 VerticalAlignment="Center"/>
                                        <TextBlock x:Name="InlineSystemSearchPlaceholder"
                                                   Text="搜索开始菜单应用"
                                                   IsHitTestVisible="False"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="14"
                                                   Foreground="{ThemeResource SecondaryTextBrush}"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                        </Border>

                        <Border Grid.Row="1"
                                Padding="12"
                                Background="{ThemeResource ControlFillBrush}"
                                BorderBrush="{ThemeResource ControlBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14">
                        <Grid>
                            <si:SystemItem x:Name="InlineSystemItems"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="Stretch"/>
                            <ProgressRing x:Name="InlineSystemLoading"
                                          Width="54"
                                          Height="54"
                                          IsActive="True"
                                          Visibility="Collapsed"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Foreground="{ThemeResource raindeskBlueBrush}"/>
                        </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <Border x:Name="VerticalCard"
                x:Load="False"
                Style="{StaticResource raindeskPanelStyle}"
                PointerPressed="VerticalCard_PointerPressed">
            <Grid Padding="24">
                <TextBlock Text="搜索结果"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource AppForegroundBrush}"/>
            </Grid>
        </Border>

        <Popup x:Name="FolderPopup"
               IsOpen="{x:Bind FolderOverlayViewModel.IsOpen, Mode=OneWay}"
               IsLightDismissEnabled="True"
               ShouldConstrainToRootBounds="False"
               Closed="FolderPopup_Closed">
        <Grid x:Name="FolderOverlay"
              Background="Transparent"
              AllowDrop="True"
              DragOver="FolderOverlay_DragOver">
            <Grid x:Name="FolderOverlayBubbleHost"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top">
                <Path Data="M 12,0 L 0,12 L 12,24 Z"
                      Width="12"
                      Height="24"
                      Stretch="Fill"
                      Fill="{ThemeResource LauncherFolderBubbleBackgroundBrush}"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      IsHitTestVisible="False"/>
            <Border x:Name="FolderOverlayPanel"
                    Width="Auto"
                    MinWidth="420"
                    MaxWidth="620"
                    MinHeight="190"
                    MaxHeight="360"
                    Margin="11,0,0,0"
                    CornerRadius="24"
                    Background="{ThemeResource LauncherFolderBubbleBackgroundBrush}"
                    BorderThickness="0"
                    Padding="24,20"
                    Tapped="FolderOverlayPanel_Tapped">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="FolderBackButton"
                                Grid.Column="0"
                                Click="FolderBackButton_Click"
                                MinWidth="44"
                                MinHeight="44"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Visibility="{x:Bind FolderOverlayViewModel.CanGoBack, Converter={StaticResource MyBoolean2VisibilityConverter}, Mode=OneWay}"
                                AutomationProperties.Name="返回上一级文件夹"
                                AutomationProperties.AutomationId="FolderBackButton"
                                ToolTipService.ToolTip="返回上一级">
                            <FontIcon Glyph="&#xE72B;" FontFamily="{StaticResource FluentIconFont}" FontSize="16" Foreground="{ThemeResource LauncherFolderBubbleTextBrush}"/>
                        </Button>
                        <TextBlock x:Name="FolderOverlayTitle"
                                   Grid.Column="1"
                                   Text="{x:Bind FolderOverlayViewModel.Title, Mode=OneWay}"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="{ThemeResource LauncherFolderBubbleTextBrush}"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="2"
                                Click="CloseFolderOverlayClick"
                                MinWidth="44"
                                MinHeight="44"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                AutomationProperties.Name="关闭文件夹"
                                AutomationProperties.AutomationId="CloseFolderButton"
                                ToolTipService.ToolTip="关闭文件夹">
                            <FontIcon Glyph="&#xE711;" FontFamily="{StaticResource FluentIconFont}" FontSize="14" Foreground="{ThemeResource LauncherFolderBubbleTextBrush}"/>
                        </Button>
                    </Grid>
                    <ListView x:Name="FolderItemsListView"
                              Grid.Row="1"
                              ItemsSource="{x:Bind FolderOverlayViewModel.Items, Mode=OneWay}"
                              Background="Transparent"
                              BorderThickness="0"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemClick="FolderItem_Click"
                              CanDragItems="True"
                              AllowDrop="True"
                              DragItemsStarting="FolderItemsListView_DragItemsStarting"
                              DragItemsCompleted="FolderItemsListView_DragItemsCompleted"
                              DragOver="FolderItemsListView_DragOver"
                              Drop="FolderItemsListView_Drop"
                              AutomationProperties.Name="文件夹内容">
                        <ListView.ItemContainerTransitions>
                            <TransitionCollection>
                                <RepositionThemeTransition IsStaggeringEnabled="False"/>
                                <AddDeleteThemeTransition/>
                            </TransitionCollection>
                        </ListView.ItemContainerTransitions>
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid HorizontalAlignment="Stretch"
                                               VerticalAlignment="Top"
                                               Orientation="Horizontal"
                                               ItemWidth="120"
                                               ItemHeight="104"/>
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:IconInfo">
                                <StackPanel Width="120"
                                            Height="104"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Spacing="8">
                                    <StackPanel.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="移出文件夹"
                                                            Click="MoveFolderChildOut"
                                                            Tag="{Binding}"
                                                            Style="{StaticResource raindeskMenuFlyoutItemStyle}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE8E5;"/>
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSubItem Text="文件夹大小"
                                                               Visibility="{Binding IsFolder, Converter={StaticResource MyBoolean2VisibilityConverter}}"
                                                               Style="{StaticResource raindeskMenuFlyoutSubItemStyle}">
                                                <MenuFlyoutItem Text="小"
                                                                Click="SetFolderSmall"
                                                                Tag="{Binding}"
                                                                Style="{StaticResource raindeskMenuFlyoutItemStyle}"/>
                                                <MenuFlyoutItem Text="中"
                                                                Click="SetFolderMedium"
                                                                Tag="{Binding}"
                                                                Style="{StaticResource raindeskMenuFlyoutItemStyle}"/>
                                                <MenuFlyoutItem Text="大"
                                                                Click="SetFolderLarge"
                                                                Tag="{Binding}"
                                                                Style="{StaticResource raindeskMenuFlyoutItemStyle}"/>
                                            </MenuFlyoutSubItem>
                                        </MenuFlyout>
                                    </StackPanel.ContextFlyout>
                                    <Grid Width="56"
                                          Height="56"
                                          HorizontalAlignment="Center">
                                        <Border Background="{ThemeResource LauncherFolderPreviewCellBrush}"
                                                BorderThickness="0"
                                                CornerRadius="14"/>
                                        <Image Source="{x:Bind BitmapImage_NoWrite, Mode=OneWay}"
                                               Width="48"
                                               Height="48"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Stretch="Uniform"/>
                                    </Grid>
                                    <TextBlock Text="{x:Bind Name, Mode=OneWay}"
                                               FontSize="13"
                                               Height="22"
                                               MaxLines="1"
                                               TextTrimming="CharacterEllipsis"
                                               TextAlignment="Center"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource LauncherFolderBubbleTextBrush}"
                                               Visibility="Visible"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
            </Grid>
        </Grid>
        </Popup>

        <ProgressRing x:Name="Loading_RightCard"
                      Width="45"
                      Height="45"
                      IsActive="True"
                      Foreground="{ThemeResource SecondaryTextBrush}"
                      Opacity="0.8"
                      Visibility="Collapsed"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>
    </Grid>
</UserControl>
