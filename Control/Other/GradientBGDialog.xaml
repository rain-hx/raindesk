<UserControl x:Class="raindesk.Control.Other.GradientBGDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:cvt="using:raindesk.Converts"
             mc:Ignorable="d"
             Width="600" Height="400">

    <UserControl.Resources>
        <cvt:TextToWindowsUIColorConverter x:Key="ColorConverter"/>
    </UserControl.Resources>

    <Border Style="{StaticResource BorderBG}" CornerRadius="8">
        <Grid>
            <TextBlock Text="提示: 右键点击可以删除自定义的背景颜色哦"
                       Foreground="{ThemeResource SecondaryTextBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,5,0,0"
                       VerticalAlignment="Top"/>

            <ListBox x:Name="GradientBGs"
                     Background="Transparent"
                     Margin="20,30,20,50"
                     BorderThickness="0"
                     AutomationProperties.Name="渐变背景列表">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="10"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="4" Width="100" Height="100"
                                PointerPressed="BGBorder_PointerPressed"
                                Tag="{Binding}"
                                AutomationProperties.Name="{Binding Name}">
                            <Border.Background>
                                <LinearGradientBrush>
                                    <GradientStop Offset="0" Color="{Binding Color1, Converter={StaticResource ColorConverter}}"/>
                                    <GradientStop Offset="1" Color="{Binding Color2, Converter={StaticResource ColorConverter}}"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border Width="100" Height="30" VerticalAlignment="Bottom"
                                    Background="{ThemeResource ShadowColor}">
                                <TextBlock Text="{Binding Name}"
                                           TextAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Foreground="{ThemeResource BadgeTextBrush}"/>
                            </Border>
                            <Border.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="删除" Click="Delete_Click" Tag="{Binding}"/>
                                </MenuFlyout>
                            </Border.ContextFlyout>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Button Content="关闭"
                    Style="{StaticResource MyBtnStyle}"
                    Click="Close_Click"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,20,10"
                    MinHeight="44"
                    AutomationProperties.Name="关闭对话框"/>
        </Grid>
    </Border>
</UserControl>
