<UserControl x:Class="raindesk.Control.Other.IconRenameDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Width="360"
             Height="176"
             Background="{ThemeResource CardBackgroundBrush}">

    <Border x:Name="DialogAnimationRoot"
            Style="{StaticResource BorderBG}"
            CornerRadius="12"
            Padding="20,16"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
        <Grid RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="重命名"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource AppForegroundBrush}"/>

            <Border x:Name="InputHost"
                    Grid.Row="1"
                    Background="{ThemeResource ControlFillBrush}"
                    BorderBrush="{ThemeResource ControlBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Height="42">
                <Grid>
                    <TextBox x:Name="IconName"
                             Style="{StaticResource DialogTextBoxStyle}"
                             VerticalAlignment="Center"
                             PlaceholderText=""
                             TextChanged="IconName_TextChanged"
                             GotFocus="IconName_GotFocus"
                             LostFocus="IconName_LostFocus"
                             AutomationProperties.Name="快捷方式名称输入框"/>
                    <TextBlock x:Name="NamePlaceholder"
                               Text="快捷方式名称"
                               IsHitTestVisible="False"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="{ThemeResource SecondaryTextBrush}"/>
                    <TextBlock x:Name="IconNameMirror"
                               IsHitTestVisible="False"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="{ThemeResource AppForegroundBrush}"
                               Visibility="Collapsed"
                               Canvas.ZIndex="1"/>
                    <Border x:Name="IconNameCaretBlinker"
                            Width="1.5"
                            Height="16"
                            Background="{ThemeResource AppForegroundBrush}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            Visibility="Collapsed"
                            Canvas.ZIndex="2"/>
                </Grid>
            </Border>

            <Grid Grid.Row="2"
                  ColumnSpacing="8"
                  Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1"
                        Content="取消"
                        Style="{StaticResource raindeskCommandButtonStyle}"
                        MinWidth="72"
                        MinHeight="36"
                        Padding="14,0"
                        Click="Cancel_Click"
                        AutomationProperties.Name="取消重命名"/>
                <Button Grid.Column="2"
                        Content="确定"
                        Style="{StaticResource raindeskPrimaryButtonStyle}"
                        MinWidth="72"
                        MinHeight="36"
                        Padding="14,0"
                        Click="Confirm_Click"
                        AutomationProperties.Name="确认重命名"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
