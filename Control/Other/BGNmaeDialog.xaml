<UserControl x:Class="raindesk.Control.Other.BGNmaeDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Width="350" Height="160">

    <Border Style="{StaticResource BorderBG}" CornerRadius="8" Padding="10">
        <StackPanel VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                <TextBlock Text="起个名字吧:"
                           Width="75"
                           TextAlignment="Left"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           FontSize="14"
                           AutomationProperties.Name="背景名称标签"/>
                <TextBox x:Name="BGName"
                         Style="{StaticResource MyTextBoxStyle}"
                         Text="{Binding Name, Mode=OneWay}"
                         Width="230"
                         FontSize="14"
                         AutomationProperties.Name="背景名称输入框"
                         PlaceholderText="请输入背景名称"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,25,0,0" HorizontalAlignment="Right">
                <Button Content="保存"
                        Style="{StaticResource MyBtnStyle}"
                        Click="Save_Click"
                        MinHeight="44"
                        AutomationProperties.Name="保存背景名称"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
