<Window x:Class="raindesk.Control.Windows.ConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:raindesk" xmlns:viewmodel="using:raindesk.ViewModel"
        Title="Setting"
        mc:Ignorable="d"
        >
    <!-- WinUI 3: WindowStyle/AllowsTransparency/Background=Transparent/ResizeMode/ShowInTaskbar/WindowStartupLocation removed -->

    <Grid Margin="18">
        <Border Background="{ThemeResource AppBackgroundBrush}" CornerRadius="14" Opacity="0.75" Margin="-4"/>

        <Grid>
            <ContentControl Margin="0">
                <Grid Background="Transparent">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="ConfigStates">
                            <VisualState x:Name="WideConfigState">
                                <VisualState.StateTriggers>
                                    <AdaptiveTrigger MinWindowWidth="800"/>
                                </VisualState.StateTriggers>
                            </VisualState>
                            <VisualState x:Name="NarrowConfigState">
                                <VisualState.StateTriggers>
                                    <AdaptiveTrigger MinWindowWidth="0"/>
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Target="SidebarColumn.Width" Value="180"/>
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="SidebarColumn" Width="230"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left sidebar navigation -->
                    <Border Grid.Row="0" Grid.Column="0"
                            Background="{ThemeResource CardBackgroundBrush}"
                            CornerRadius="16,0,0,16"
                            BorderBrush="{ThemeResource DividerBrush}"
                            BorderThickness="0,0,1,0"
                            Padding="10,28">
                        <ListBox Background="Transparent" Margin="0"
                                 BorderThickness="0" SelectedIndex="0"
                                 SelectionChanged="MemuClick">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource raindeskListBoxMenuStyle}"/>
                            </ListBox.ItemContainerStyle>
                            <ListBoxItem IsSelected="True" Tag="Theme">
                                <StackPanel Orientation="Horizontal" Spacing="14">
                                    <FontIcon Glyph="&#xE7F4;" FontFamily="Segoe Fluent Icons" FontSize="20"/>
                                    <TextBlock Text="显示设置" FontSize="16" FontWeight="SemiBold"/>
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem Tag="Motion">
                                <StackPanel Orientation="Horizontal" Spacing="14">
                                    <FontIcon Glyph="&#xF8B0;" FontFamily="Segoe Fluent Icons" FontSize="20"/>
                                    <TextBlock Text="动作" FontSize="16" FontWeight="SemiBold"/>
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem Tag="Other">
                                <StackPanel Orientation="Horizontal" Spacing="14">
                                    <FontIcon Glyph="&#xECA5;" FontFamily="Segoe Fluent Icons" FontSize="20"/>
                                    <TextBlock Text="其它" FontSize="16" FontWeight="SemiBold"/>
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem Tag="Help">
                                <StackPanel Orientation="Horizontal" Spacing="14">
                                    <FontIcon Glyph="&#xE897;" FontFamily="Segoe Fluent Icons" FontSize="20"/>
                                    <TextBlock Text="帮助" FontSize="16" FontWeight="SemiBold"/>
                                </StackPanel>
                            </ListBoxItem>
                        </ListBox>
                    </Border>

                    <!-- Right content area -->
                    <ScrollViewer Grid.Row="0" Grid.Column="1" BorderThickness="0" Padding="0">
                        <Grid x:Name="UFG" Padding="26">
                            <Border x:Name="RightCard"
                                    Background="Transparent"
                                    PointerPressed="DragMove"
                                    Padding="0"/>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </ContentControl>
        </Grid>
    </Grid>

</Window>
