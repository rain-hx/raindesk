<ContentDialog
    x:Class="raindesk.Control.Windows.QuickAddDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="快速添加任务"
    PrimaryButtonText="添加"
    SecondaryButtonText="取消"
    DefaultButton="Primary"
    PrimaryButtonClick="OnAdd"
    SecondaryButtonClick="OnCancel"
    MaxWidth="420"
    Opened="OnOpened">

    <StackPanel Spacing="16" Padding="0,8">

        <!-- 标题输入（唯一必填项，参考 TaskTrove 的 quick-add） -->
        <TextBox
            x:Name="TitleBox"
            PlaceholderText="输入任务标题... (如: 明天下午3点开会 P1)"
            FontSize="16"
            KeyDown="OnTitleKeyDown"/>

        <!-- 快捷操作按钮（参考 TaskTrove 的 pill buttons，窄窗口时自动换行） -->
        <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4">
            <VariableSizedWrapGrid.Resources>
                <Style TargetType="Button">
                    <Setter Property="Padding" Value="12,6"/>
                    <Setter Property="Background" Value="{ThemeResource CardBackgroundBrush}"/>
                    <Setter Property="BorderBrush" Value="{ThemeResource CardBorderBrush}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="CornerRadius" Value="4"/>
                    <Setter Property="Margin" Value="0,0,8,8"/>
                </Style>
            </VariableSizedWrapGrid.Resources>
            <!-- 日期 -->
            <Button
                x:Name="DateButton"
                Content="📅 日期"
                Click="OnDateClick"/>
            <Button
                x:Name="TodayButton"
                Content="今天"
                Click="OnTodayClick"/>
            <Button
                x:Name="TomorrowButton"
                Content="明天"
                Click="OnTomorrowClick"/>

            <!-- 优先级 -->
            <Button
                x:Name="PriorityButton"
                Content="优先级"
                Click="OnPriorityClick"/>
        </VariableSizedWrapGrid>

        <!-- 选中的日期显示 -->
        <StackPanel
            x:Name="SelectedDateRow"
            Orientation="Horizontal"
            Spacing="8"
            Visibility="Collapsed">
            <TextBlock Text="📅" VerticalAlignment="Center"/>
            <TextBlock
                x:Name="SelectedDateText"
                VerticalAlignment="Center"
                Foreground="{ThemeResource AccentTextBrush}"/>
            <Button
                Content="×"
                Click="OnClearDate"
                Padding="4"
                Background="Transparent"
                FontSize="12"
                AutomationProperties.Name="清除日期"/>
        </StackPanel>

        <!-- 选中的优先级显示 -->
        <StackPanel
            x:Name="SelectedPriorityRow"
            Orientation="Horizontal"
            Spacing="8"
            Visibility="Collapsed">
            <TextBlock
                x:Name="SelectedPriorityText"
                VerticalAlignment="Center"/>
            <Button
                Content="×"
                Click="OnClearPriority"
                Padding="4"
                Background="Transparent"
                FontSize="12"
                AutomationProperties.Name="清除优先级"/>
        </StackPanel>

        <!-- 日期选择器（展开时显示） -->
        <CalendarDatePicker
            x:Name="DatePicker"
            PlaceholderText="选择日期"
            Visibility="Collapsed"
            DateChanged="OnDateChanged"/>

    </StackPanel>
</ContentDialog>
