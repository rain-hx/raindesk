<Window x:Class="raindesk.Control.Windows.SystemItemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:uc="using:raindesk.Control.UserControls.SystemItem"
        mc:Ignorable="d"
        Title="系统项目">
    <Grid Background="{ThemeResource AppBackgroundBrush}">
        <Border Margin="16"
                Style="{StaticResource raindeskPanelStyle}"
                PointerPressed="DragMove">
            <Grid Padding="26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 顶部导航与搜索保持在同一行，避免 TabView 默认模板把工具栏撑成多行。 -->
                <Grid Height="58"
                      ColumnSpacing="20"
                      VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TabView x:Name="MyTabControl"
                             Height="56"
                             MinHeight="56"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Center"
                             SelectionChanged="TabControl_SelectionChanged"
                             IsAddTabButtonVisible="False"
                             CanDragTabs="False"
                             Background="Transparent">
                        <TabView.Resources>
                            <Style TargetType="TabViewItem">
                                <Setter Property="FontSize" Value="17"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Height" Value="56"/>
                                <Setter Property="MinHeight" Value="56"/>
                                <Setter Property="Padding" Value="14,0"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                            </Style>
                        </TabView.Resources>
                        <TabViewItem Tag="System" Header="系统应用" IsClosable="False"/>
                        <TabViewItem x:Name="StartMenu" Tag="StartMenu" Header="开始菜单应用" IsClosable="False"/>
                    </TabView>
                    <Border Grid.Column="1"
                            BorderBrush="{ThemeResource ControlBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Background="{ThemeResource ControlFillBrush}"
                            Padding="12,0"
                            MinWidth="240"
                            MaxWidth="360"
                            Width="300"
                            Height="56"
                            VerticalAlignment="Center">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE721;"
                                      FontFamily="Segoe Fluent Icons"
                                      FontSize="16"
                                      Foreground="{ThemeResource SecondaryTextBrush}"
                                      VerticalAlignment="Center"/>
                            <TextBox x:Name="SearchBox"
                                     Grid.Column="1"
                                     PlaceholderText="搜索开始菜单应用"
                                     TextChanged="SearchBox_TextChanged"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="1" Margin="0,18,0,0">
                    <uc:SystemItem x:Name="SystemItem"/>
                    <uc:SystemItem x:Name="StartMenuItem" Visibility="Collapsed"/>
                    <ProgressRing x:Name="StartMenuLoading"
                                  Width="54"
                                  Height="54"
                                  IsActive="True"
                                  Visibility="Collapsed"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Foreground="{ThemeResource raindeskBlueBrush}"/>
                </Grid>

                <Button Grid.Row="2"
                        Content="关闭"
                        Style="{StaticResource raindeskCommandButtonStyle}"
                        Click="Close_Click"
                        HorizontalAlignment="Right"
                        Margin="0,18,0,0"
                        MinWidth="136"
                        Padding="22,10"/>
            </Grid>
        </Border>
    </Grid>
</Window>
