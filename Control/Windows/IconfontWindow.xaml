<Window x:Class="raindesk.Control.Windows.IconfontWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:raindesk.Control.Windows"
        xmlns:uc="using:raindesk.Control.UserControls.IconFont"
        mc:Ignorable="d"
        Title="">
    <Grid x:Name="RootGrid" Margin="20">
        <Border Background="{ThemeResource AppBackgroundBrush}" CornerRadius="12" Opacity="0.4" Margin="-4"/>
        <Border x:Name="ContentBorder"
                Style="{StaticResource BorderBG}"
                Width="660"
                Height="480">
            <Grid x:Name="LayoutGrid"
                  Margin="20,24,20,20"
                  RowDefinitions="Auto,*,Auto"
                  RowSpacing="16">
                <Border x:Name="TitleBarHost"
                        Grid.Row="0"
                        MinHeight="40"
                        Background="Transparent">
                    <TextBlock Text="系统图标"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource AppForegroundBrush}"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"/>
                </Border>

                <uc:IconPannel x:Name="SystemIcon" Grid.Row="1"/>

                <StackPanel x:Name="ButtonPanel"
                            Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="12">
                    <Button x:Name="CancelButton" Style="{StaticResource MyBtnStyle}" Content="取消" Click="Close_Click" MinWidth="88"/>
                    <Button x:Name="ConfirmButton"
                            Style="{StaticResource MyBtnStyle}"
                            Content="确定"
                            Click="Confirm_Click"
                            MinWidth="88"
                            IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
