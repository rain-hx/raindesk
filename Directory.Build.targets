<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- Override NuGet RunPackagedApp after Sdk.targets so dev launch does not fail the build. -->
  <Target Name="_raindeskStopRunningInstance"
          BeforeTargets="RunPackagedApp"
          Condition="'$(MSBuildProjectName)' == 'raindesk' and '$(EnableWinAppRunSupport)' == 'true'">
    <Exec Command="taskkill /IM raindesk.exe /F /T"
          IgnoreExitCode="true"
          ContinueOnError="true" />
  </Target>

  <!-- RunPackagedApp must build first; loose-layout copy reads apphost.exe from obj output. -->
  <Target Name="_raindeskPreparePackagedRun"
          Condition="'$(MSBuildProjectName)' == 'raindesk' and '$(EnableWinAppRunSupport)' == 'true' and '$(WindowsPackageType)' != 'None'">
    <CallTarget Targets="Build" />
    <CallTarget Targets="_WinAppBuildRunArgs;_WinAppCopyContentToLooseLayout" />
  </Target>

  <Target Name="RunPackagedApp"
          DependsOnTargets="_raindeskPreparePackagedRun"
          Condition="'$(MSBuildProjectName)' == 'raindesk' and '$(EnableWinAppRunSupport)' == 'true' and '$(WindowsPackageType)' != 'None'">
    <Message Text="[raindesk] Launching packaged application..." Importance="high" />
    <Exec Command="&quot;$(WinAppCliPath)&quot; $(_WinAppRunArgs)"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          IgnoreExitCode="true" />
  </Target>
</Project>
